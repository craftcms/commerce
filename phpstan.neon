includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    level: 5
    paths:
        - src
    scanDirectories:
        - src-yii2
    scanFiles:
        - ../cms-6/yii2-adapter/legacy/Craft.php
        - ../cms-6/yii2-adapter/lib/yii2/Yii.php
        - vendor/twig/twig/src/Extension/CoreExtension.php
        - vendor/craftcms/cms/src/helpers.php
    databaseMigrationsPath:
        - database/migrations