{% import '_includes/forms' as forms %}

<div>

{% set updateQuantities %}
    <div class="flex">
        <div>
        {{ forms.select({
            id: 'updateAction',
            name: 'updateAction',
            value: updateAction,
            options: [
                { label: "Set to"|t('commerce'), value: "set" },
                { label: "Adjust by"|t('commerce'), value: "adjust" }
            ]
        }) }}
        </div>
        <div>
            {{ forms.text({
                id: 'quantity',
                name: 'quantity',
                value: quantity,
                type: 'number'
            }) }}
        </div>
    </div>
{% endset %}

{{ forms.field({
    label: "Set or Adjust"|t('commerce'),
    id: 'updateQuantities'
}, updateQuantities) }}

{{ forms.textField({
    label: "Notes"|t('commerce'),
    id: 'note',
    name: 'note',
    value: note
}) }}

<div id="inventory-levels" class="js-inventory-levels-preview">
{% include 'commerce/inventory/levels/_updateInventoryLevelPreview' %}
</div>

{{ forms.hidden({
    name: 'inventoryLocationId',
    value: inventoryLocationId
}) }}

{{ forms.hidden({
    name: 'type',
    value: type
}) }}

{# We use ids to be compatible with the admin table #}
{% for id in inventoryItemIds %}
    {{ forms.hidden({
        name: 'ids[]',
        value: id
    }) }}
{% endfor %}

</div>