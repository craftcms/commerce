<fieldset class="card-holder">
    <legend>{{ 'Card Holder'|t('commerce') }}</legend>

    <div class="md:flex md:-mx-4">
        <!-- Card Holder Name -->
        <div class="md:w-1/2 md:mx-4 my-2">
            {{ craft.cp.text({
                name: 'firstName',
                maxlength: 70,
                placeholder: "First Name"|t('commerce'),
                autocomplete: false,
                class: 'card-holder-first-name'~(paymentForm.errors().get('firstName') ? ' error'),
                value: paymentForm.firstName,
                required: true,
            })|raw }}
        </div>

        <div class="md:w-1/2 md:mx-4 my-2">
            {{ craft.cp.text({
                name: 'lastName',
                maxlength: 70,
                placeholder: "Last Name"|t('commerce'),
                autocomplete: false,
                class: 'card-holder-last-name'~(paymentForm.errors().get('lastName') ? ' error'),
                value: paymentForm.lastName,
                required: true,
            })|raw }}
        </div>
    </div>

    {% set errors = [] %}
    {% for attributeKey in ['firstName', 'lastName'] %}
        {% set errors = errors|merge(paymentForm.errors().get(attributeKey)) %}
    {% endfor %}

    {{ _self.errorList(errors) }}
</fieldset>

<!-- Card Number -->
<fieldset class="card-data">
    <legend>{{ 'Card'|t('commerce') }}</legend>

    <div>
        <div>
            {{ craft.cp.text({
                name: 'number',
                maxlength: 19,
                placeholder: "Card Number"|t('commerce'),
                autocomplete: false,
                class: 'card-number'~(paymentForm.errors().get('number') ? ' error'),
                value: paymentForm.number
            })|raw }}

        </div>

        <div>
            {{ craft.cp.text({
                class: 'card-expiry'~(paymentForm.errors().get('month') or paymentForm.errors().get('year') ? ' error'),
                type: 'text',
                name: 'expiry',
                placeholder: "MM"|t('commerce')~' / '~"YYYY"|t('commerce'),
                value: paymentForm.expiry
            })|raw }}

            {{ craft.cp.text({
                type: 'tel',
                name: 'cvv',
                placeholder: "CVV"|t('commerce'),
                class: 'card-cvc'~(paymentForm.errors().get('cvv') ? ' error'),
                value: paymentForm.cvv
            })|raw }}
        </div>
    </div>

    {% set errors = [] %}
    {% for attributeKey in ['number', 'month', 'year', 'cvv'] %}
        {% set errors = errors|merge(paymentForm.errors().get(attributeKey)) %}
    {% endfor %}

    {{ _self.errorList(errors) }}

</fieldset>
{% macro errorList(errors) %}
    {% if errors|length %}
        <ul class="errors">
            {% for error in errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}
