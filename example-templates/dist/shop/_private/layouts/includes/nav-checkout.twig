<!-- Template: {{ _self }}.twig -->
{#
Outputs the checkout progress navigation using the request path and included `checkoutSteps` array.
#}
{% set checkoutSteps = [
  {
    label: 'Email',
    url: 'shop/checkout/email'
  },
  {
    label: 'Account',
    url: 'shop/checkout/register-signin'
  },
  {
    label: 'Address',
    url: 'shop/checkout/addresses'
  },
  {
    label: 'Shipping',
    url: 'shop/checkout/shipping'
  },
  {
    label: 'Payment Method',
    url: 'shop/checkout/payment-method'
  },
  {
    label: 'Options',
    url: 'shop/checkout/options'
  },
  {
    label: 'Payment',
    url: 'shop/checkout/payment'
  }
] %}

{% set currentPath = Request.path() %}
{% set currentIndex = checkoutSteps|column('url')|keys|filter(i => checkoutSteps[i].url == currentPath)|first %}

{% if currentIndex is not same as(false) and currentIndex is not null %}
  <nav class="border-b border-gray-200 bg-white" aria-label="{{ 'Checkout progress'|t }}">
    <ol class="mx-auto flex max-w-7xl items-center gap-2 overflow-x-auto px-4 py-4 text-sm sm:px-6 lg:px-8">
      {% for step in checkoutSteps %}
        {% set index = loop.index0 %}
        <li class="flex shrink-0 items-center gap-2">
          {% if index == currentIndex %}
            <span class="flex items-center gap-2 font-semibold text-blue-600" aria-current="step">
              <span class="flex size-6 items-center justify-center rounded-full border-2 border-blue-600 text-xs">{{ loop.index }}</span>
              {{- step.label|t -}}
            </span>
          {% elseif index < currentIndex %}
            <a href="{{ url(step.url) }}" class="flex items-center gap-2 text-gray-900 hover:text-blue-600">
              <span class="flex size-6 items-center justify-center rounded-full bg-blue-600 text-xs text-white">
                <svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd"/></svg>
              </span>
              {{- step.label|t -}}
            </a>
          {% else %}
            <a href="{{ url(step.url) }}" class="flex items-center gap-2 text-gray-500 hover:text-gray-700">
              <span class="flex size-6 items-center justify-center rounded-full border border-gray-300 text-xs">{{ loop.index }}</span>
              {{- step.label|t -}}
            </a>
          {% endif %}
          {% if not loop.last %}
            <span class="h-px w-6 bg-gray-300 sm:w-10" aria-hidden="true"></span>
          {% endif %}
        </li>
      {% endfor %}
    </ol>
  </nav>
{% endif %}
