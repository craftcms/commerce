<!-- Template: {{ _self }}.twig -->
{#
Outputs the site’s global main navigation based on path and included `pages` array.

@var cart        \CraftCms\Commerce\Order\Elements\Order
@var currentUser \CraftCms\Cms\User\Elements\User
#}
{% set pages = [
  {
    label: 'Orders',
    url: 'shop/customer/orders'
  },
  {
    label: 'Addresses',
    url: 'shop/customer/addresses'
  },
  {
    label: 'Saved cards',
    url: 'shop/customer/cards'
  }
] %}
{% set currentPath = Request.path() %}
{# Show the nav if we’re on a customer page #}
{% if currentPath in pages|column('url') %}
  <nav class="border-b border-gray-200 bg-white" aria-label="{{ 'Account'|t }}">
    <div class="mx-auto flex max-w-7xl gap-6 px-4 sm:px-6 lg:px-8">
      {% for page in pages %}
        {% set isActive = page.url in currentPath %}
        <a href="{{ url(page.url) }}"
           class="border-b-2 py-4 text-sm font-medium {{ isActive ? 'border-blue-600 text-blue-600' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700' }}"
           {% if isActive %}aria-current="page"{% endif %}>
          {{- page.label|t -}}
        </a>
      {% endfor %}
    </div>
  </nav>
{% endif %}
