<!-- Template: {{ _self }}.twig -->
{#
Outputs the global site footer.

@var currentUser \CraftCms\Cms\User\Elements\User
#}
<div class="mx-auto grid max-w-7xl gap-8 px-4 py-10 text-sm text-gray-500 sm:px-6 md:grid-cols-3 lg:px-8">
  <div class="md:col-span-2">
    <p class="font-semibold text-gray-900">{{ 'Example templates'|t }}</p>
    <p class="mt-2 max-w-prose">
      {{ 'These Craft Commerce {version} example templates use <a href="{url}" class="{classes}">Tailwind CSS</a> and native JavaScript. You’re running the {edition} edition of Craft Commerce.'|t({
        url: 'https://tailwindcss.com',
        classes: 'font-medium text-blue-600 hover:text-blue-500',
        edition: craft.commerce.edition|upper,
        version: craft.commerce.version,
      })|raw }}
    </p>
    <p class="mt-4">
      {% if currentUser %}
        {{ 'Signed in as {user}.'|t({ user: '<span class="font-medium text-gray-900">' ~ currentUser.username|e ~ '</span>' })|raw }}
        {% if currentUser.groups %}
          {{ 'User groups: {groups}.'|t({ groups: currentUser.groups|map(g => g.name|e)|join(', ') })|raw }}
        {% endif %}
      {% else %}
        {{- 'You’re browsing as a guest.'|t -}}
      {% endif %}
    </p>
  </div>
  <div>
    <p class="font-semibold text-gray-900">{{ 'Resources'|t }}</p>
    <ul class="mt-2 space-y-2">
      <li><a href="https://craftcms.com/docs/commerce/" class="hover:text-gray-900">{{ 'Commerce documentation'|t }}</a></li>
      <li><a href="https://craftcms.com/docs/" class="hover:text-gray-900">{{ 'Craft documentation'|t }}</a></li>
      <li><a href="https://craftcms.com/discord" class="hover:text-gray-900">{{ 'Craft Discord community'|t }}</a> <span class="text-xs">(#commerce)</span></li>
    </ul>
  </div>
</div>
