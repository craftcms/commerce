{% extends 'shop/_private/layouts' %}
{#
Outputs form for collecting a cart number to be loaded.
#}
{% block main %}
  <!-- Template: {{ _self }}.twig -->
  <div class="mx-auto max-w-md rounded-lg border border-gray-200 bg-white p-6 shadow-xs sm:p-8">
    <h1 class="text-xl font-semibold">{{ 'Load a cart'|t }}</h1>
    <p class="mt-1 text-sm text-gray-500">{{ 'Enter a cart number to load that cart into the current session.'|t }}</p>

    <form method="post" action="" class="mt-6 space-y-5">
      {{ csrfInput() }}
      {{ actionInput('commerce/cart/load') }}
      {{ redirectInput('shop/cart') }}

      <div>
        <label for="number" class="block text-sm font-medium text-gray-700">{{ 'Cart number'|t }}</label>
        {{ input('text', 'number', null, {
          id: 'number',
          class: 'mt-1 w-full font-mono block rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600',
          placeholder: '7e89fh0ew8034…'
        }) }}
      </div>

      {{ tag('button', {
        type: 'submit',
        class: 'w-full inline-flex cursor-pointer items-center justify-center gap-2 rounded-md px-4 py-2.5 text-sm font-semibold shadow-xs transition focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-blue-600 text-white hover:bg-blue-500 focus-visible:outline-blue-600',
        text: 'Load cart'|t
      }) }}
    </form>
  </div>
{% endblock %}
