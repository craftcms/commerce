<!-- Template: {{ _self }}.twig -->
{#
Outputs a form for collecting shipping estimate address details if an address doesn’t yet exist on the cart.

@var cart \CraftCms\Commerce\Order\Elements\Order
#}
{% if not cart.getShippingAddress() %}
  {% set countries = Addresses.getCountryRepository().getList() %}
  {% set states = [] %}
{#  {% set states = craft.commerce.states.allEnabledStatesAsListGroupedByCountryId %}#}

  <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-xs">
    <h2 class="text-base font-semibold">
      {{- 'Estimate shipping'|t -}}
    </h2>
    <p class="mt-1 text-sm text-gray-500">{{ 'Enter your location to see shipping options and costs.'|t }}</p>

    <div class="js-estimate-fields">
      <label class="mt-4 block text-sm font-medium text-gray-700" for="estimatedShippingAddress-countryCode">
        {{- 'Country'|t -}}
      </label>
      {% tag 'select' with {
        name: 'estimatedShippingAddress[countryCode]',
        'data-modelname': 'estimatedShippingAddress',
        class: ['js-address-country', 'js-estimate-country', 'w-full', 'max-w-full', 'block appearance-none rounded-md bg-white bg-[url("data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%2020%2020%27%20fill=%27%236b7280%27%3E%3Cpath%20fill-rule=%27evenodd%27%20d=%27M5.22%208.22a.75.75%200%200%201%201.06%200L10%2011.94l3.72-3.72a.75.75%200%201%201%201.06%201.06l-4.25%204.25a.75.75%200%200%201-1.06%200L5.22%209.28a.75.75%200%200%201%200-1.06Z%27%20clip-rule=%27evenodd%27/%3E%3C/svg%3E")] bg-size-[1.25rem] bg-position-[right_0.5rem_center] bg-no-repeat py-2 pr-9 pl-3 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600']
      } %}
        {{ tag('option', {
          value: '',
          disabled: true,
          selected: not cart.estimatedShippingAddress,
          text: 'Select country'|t ~ '...'
        }) }}
        {% for key, option in countries %}
          {% set optionValue = (cart.estimatedShippingAddress ? cart.estimatedShippingAddress.countryCode : '') %}
          {{ tag('option', {
            value: key,
            selected: key == optionValue,
            text: option
          }) }}
        {% endfor %}
      {% endtag %}

      <div class="mt-1 grid gap-x-3 sm:grid-cols-2">
        <div class="">
          <div class="js-estimate-state-box" data-modelname="estimatedShippingAddress">
            <label class="mt-4 block text-sm font-medium text-gray-700" for="estimatedShippingAddress-state">
              {{- 'State'|t -}}
            </label>
            {% set options = (cart.estimatedShippingAddress and states[cart.estimatedShippingAddress.countryCode] is defined ?
              states[cart.estimatedShippingAddress.countryCode] : []
              ) %}
            {% tag 'select' with {
              name: 'estimatedShippingAddress[stateValue]',
              id: 'estimatedShippingAddress-stateId',
              'data-modelname': 'estimatedShippingAddress',
              class: ['js-address-stateId', 'max-w-full', options|length == 0 ? 'hidden' : '', 'block appearance-none rounded-md bg-white bg-[url("data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%2020%2020%27%20fill=%27%236b7280%27%3E%3Cpath%20fill-rule=%27evenodd%27%20d=%27M5.22%208.22a.75.75%200%200%201%201.06%200L10%2011.94l3.72-3.72a.75.75%200%201%201%201.06%201.06l-4.25%204.25a.75.75%200%200%201-1.06%200L5.22%209.28a.75.75%200%200%201%200-1.06Z%27%20clip-rule=%27evenodd%27/%3E%3C/svg%3E")] bg-size-[1.25rem] bg-position-[right_0.5rem_center] bg-no-repeat py-2 pr-9 pl-3 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600']
            } %}
              {{ tag('option', {
                value: '',
                disabled: true,
                selected: not cart.estimatedShippingAddress,
                text: 'Select state'|t ~ '...'
              }) }}
              {% for key, option in options %}
                {% set optionValue = (cart.estimatedShippingAddress ? cart.estimatedShippingAddress.stateId : '') %}
                {{ tag('option', {
                  value: key,
                  selected: key == optionValue,
                  text: option
                }) }}
              {% endfor %}
            {% endtag %}

            {{ input('text', options|length == 0 ? 'estimatedShippingAddress[stateValue]', cart.estimatedShippingAddress ? cart.estimatedShippingAddress.administrativeArea : '', {
              id: 'estimatedShippingAddress-administrativeArea',
              'data-modelname': 'estimatedShippingAddress',
              class: ['js-address-administrativeArea', 'w-full', options|length > 0 ? 'hidden' : '', 'block rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600']
            }) }}
          </div>
        </div>
        <div class="">
          <label class="mt-4 block text-sm font-medium text-gray-700" for="estimatedShippingAddress-postalCode">
            {{- 'Postal Code'|t -}}
          </label>
          {{ input('text', 'estimatedShippingAddress[postalCode]', cart.estimatedShippingAddress ? cart.estimatedShippingAddress.postalCode : '', {
            id: 'estimatedShippingAddress-postalCode',
            'data-modelname': 'estimatedShippingAddress',
            class: ['w-full', 'block rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600']
          }) }}
        </div>
      </div>

      <div class="mt-4">
        <label class="flex items-center gap-2 text-sm text-gray-700">
          {{ input('checkbox', 'estimatedBillingAddressSameAsShipping', 1, {
            checked: cart.estimatedShippingAddressId == cart.estimatedBillingAddressId,
            class: 'size-4 accent-blue-600'
          }) }}
          {{ 'Use the same address for tax'|t }}
        </label>
      </div>


      <div class="js-estimate-billing mt-6">
        <h2 class="text-base font-semibold">
          {{- 'Estimate tax'|t -}}
        </h2>
        <label class="mt-4 block text-sm font-medium text-gray-700" for="estimatedBillingAddress-countryCode">
          {{- 'Country'|t -}}
        </label>
        {% tag 'select' with {
          name: 'estimatedBillingAddress[countryCode]',
          'data-modelname': 'estimatedBillingAddress',
          class: ['js-address-country', 'js-estimate-country', 'w-full', 'max-w-full', 'block appearance-none rounded-md bg-white bg-[url("data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%2020%2020%27%20fill=%27%236b7280%27%3E%3Cpath%20fill-rule=%27evenodd%27%20d=%27M5.22%208.22a.75.75%200%200%201%201.06%200L10%2011.94l3.72-3.72a.75.75%200%201%201%201.06%201.06l-4.25%204.25a.75.75%200%200%201-1.06%200L5.22%209.28a.75.75%200%200%201%200-1.06Z%27%20clip-rule=%27evenodd%27/%3E%3C/svg%3E")] bg-size-[1.25rem] bg-position-[right_0.5rem_center] bg-no-repeat py-2 pr-9 pl-3 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600']
        } %}
          {{ tag('option', {
            value: '',
            disabled: true,
            selected: not cart.estimatedBillingAddress,
            text: 'Select country'|t ~ '...'
          }) }}
          {% for key, option in countries %}
            {% set optionValue = (cart.estimatedBillingAddress ? cart.estimatedBillingAddress.countryCode : '') %}
            {{ tag('option', {
              value: key,
              selected: key == optionValue,
              text: option
            }) }}
          {% endfor %}
        {% endtag %}

        <div class="mt-1 grid gap-x-3 sm:grid-cols-2">
          <div class="">
            <div class="js-estimate-state-box" data-modelname="estimatedBillingAddress">
              <label class="block text-sm font-medium text-gray-700" for="estimatedBillingAddress-state">
                {{- 'State'|t -}}
              </label>
              {% set options = (cart.estimatedBillingAddress and states[cart.estimatedBillingAddress.countryCode] is defined ?
                states[cart.estimatedBillingAddress.countryCode] : []
                ) %}
              {% tag 'select' with {
                name: 'estimatedBillingAddress[stateValue]',
                id: 'estimatedBillingAddress-stateId',
                'data-modelname': 'estimatedBillingAddress',
                class: ['js-address-stateId', 'w-full', 'max-w-full', options|length == 0 ? 'hidden', 'block appearance-none rounded-md bg-white bg-[url("data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%2020%2020%27%20fill=%27%236b7280%27%3E%3Cpath%20fill-rule=%27evenodd%27%20d=%27M5.22%208.22a.75.75%200%200%201%201.06%200L10%2011.94l3.72-3.72a.75.75%200%201%201%201.06%201.06l-4.25%204.25a.75.75%200%200%201-1.06%200L5.22%209.28a.75.75%200%200%201%200-1.06Z%27%20clip-rule=%27evenodd%27/%3E%3C/svg%3E")] bg-size-[1.25rem] bg-position-[right_0.5rem_center] bg-no-repeat py-2 pr-9 pl-3 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600']
              } %}
                {{ tag('option', {
                  value: '',
                  disabled: true,
                  selected: not cart.estimatedBillingAddress,
                  text: 'Select state'|t ~ '...'
                }) }}
                {% for key, option in options %}
                  {% set optionValue = (cart.estimatedBillingAddress ? cart.estimatedBillingAddress.stateId : '') %}
                  {{ tag('option', {
                    value: key,
                    selected: key == optionValue,
                    text: option
                  }) }}
                {% endfor %}
              {% endtag %}
              {{ input('text', options|length == 0 ? 'estimatedBillingAddress[stateValue]', cart.estimatedBillingAddress ? cart.estimatedBillingAddress.administrativeArea : '', {
                id: 'estimatedBillingAddress-administrativeArea',
                'data-modelname': 'estimatedBillingAddress',
                class: ['js-address-administrativeArea', options|length > 0 ? 'hidden', 'w-full', 'block rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600']
              }) }}
            </div>
          </div>
          <div class="">
            <label class="block text-sm font-medium text-gray-700" for="estimatedBillingAddress-postalCode">
              {{- 'Postal Code' -}}
            </label>
            {{ input('text', options|length == 0 ? 'estimatedBillingAddress[postalCode]', cart.estimatedBillingAddress ? cart.estimatedBillingAddress.postalCode : '', {
              id: 'estimatedBillingAddress-postalCode',
              class: ['w-full', 'block rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600']
            }) }}
          </div>
        </div>
      </div>
    </div>

    <div class="js-estimate-shipping-methods">
      {% if cart.availableShippingMethodOptions|length and cart.estimatedShippingAddressId %}
        <div class="mt-3">
          <div class="space-y-2">
            {% for handle, method in cart.availableShippingMethodOptions %}
              <div class="js-shipping-select">
                <label class="flex items-center gap-3 block cursor-pointer rounded-lg border border-gray-200 bg-white px-4 py-3 shadow-xs hover:border-gray-300 has-checked:border-blue-600 has-checked:ring-1 has-checked:ring-blue-600">
                  {{ input('radio', 'shippingMethodHandle', handle, {
                    checked: handle == cart.shippingMethodHandle,
                    class: 'size-4 accent-blue-600'
                  }) }}
                  <span class="flex-1 text-sm font-medium">{{ method.name }}</span>
                  <span class="text-sm tabular-nums" title="{{ method.priceForOrder(cart) }}">
                    {{- method.priceForOrder(cart)|commerceCurrency(cart.currency) -}}
                  </span>
                </label>
              </div>
            {% endfor %}
          </div>
        </div>
        <div class="mt-4">
          <a class="font-medium text-blue-600 hover:text-blue-500 js-estimate-show-fields" href="#">
            {{- 'Show estimate fields'|t -}}
          </a>
        </div>
      {% endif %}
    </div>
  </div>

  {% js %}
  {% set enabledStates = {} %}
{#{% for cId, cStates in craft.commerce.states.allEnabledStatesAsListGroupedByCountryId %}#}
{% for cId, cStates in [] %}
    {% set eStates = {} %}
    {% for sId, s in cStates %}
        {% set eStates = eStates|merge({ ('state-' ~ sId): s }) %}
    {% endfor %}
    {% set enabledStates = enabledStates|merge({('country-' ~ cId): eStates}) %}
{% endfor %}

window.states = {{ enabledStates|json_encode|raw }};
  {% endjs %}

  {% js %}
  var $estimateShippingMethodsContainer = document.querySelector('.js-estimate-shipping-methods');
  var $estimateFieldsContainer = document.querySelector('.js-estimate-fields');
  var $estimateShowFieldsButton = document.querySelector('.js-estimate-show-fields');
  var $estimateBilling = document.querySelector('.js-estimate-billing');
  var $estimateBillingSameAsShipping = document.querySelector('input[name="estimatedBillingAddressSameAsShipping"]');
  var $estimateCountrySelects = document.querySelectorAll('select.js-estimate-country');

  function _estimatorHide(el) {
    el.classList.add('hidden');
    var inputs = el.querySelectorAll('input,select');
    if (inputs.length) {
      inputs.forEach(function(el) {
        el.disabled = true;
      });
    }
  }

  function _estimatorShow(el) {
    el.classList.remove('hidden');
    var inputs = el.querySelectorAll('input,select');
    if (inputs.length) {
      inputs.forEach(function(el) {
        el.disabled = false;
      });
    }
  }

  // Setup "same as" checkbox
  if ($estimateBillingSameAsShipping.checked) {
    _estimatorHide($estimateBilling);
  }

  // Handle the change event for the "same as" checkbox
  $estimateBillingSameAsShipping.addEventListener('change', function(event) {
    var $this = event.target;
    if ($this.checked) {
      _estimatorHide($estimateBilling);
    } else {
      _estimatorShow($estimateBilling);
    }
  });

  // Setup initial state showing/hiding of the shipping method selection
  var shippingSelect = $estimateShippingMethodsContainer.querySelector('.js-shipping-select');
  if (shippingSelect) {
    _estimatorHide($estimateFieldsContainer);
  } else {
    _estimatorHide($estimateShippingMethodsContainer);
  }

  // Handle click event for returning to the estimate fields
  if ($estimateShowFieldsButton) {
    $estimateShowFieldsButton.addEventListener('click', function(event) {
      event.preventDefault();

      if ($estimateFieldsContainer.classList.contains('hidden')) {
        _estimatorShow($estimateFieldsContainer);
        _estimatorHide($estimateShippingMethodsContainer);
      } else {
        _estimatorHide($estimateFieldsContainer);
        _estimatorShow($estimateShippingMethodsContainer);
      }
    });
  }

  // Handle change event for country selection for both shipping and billing
  $estimateCountrySelects.forEach(element => {
    element.addEventListener('change', event => {
      // get the value of the selected country.
      var $this = event.target;
      var cid = $this.value;
      var $box = document.querySelector('.js-estimate-state-box[data-modelname="' + $this.dataset.modelname + '"]');
      var $states = $box.querySelector('select.js-address-stateId');
      var $administrativeArea = $box.querySelector('input.js-address-administrativeArea');
      var $statesOption = $states.querySelectorAll('option:not([value=""]');

      if ($statesOption.length) {
        $statesOption.forEach(function(el) {
          el.remove();
        });
      }

      var countryKey = 'country-' + cid;
      if (window.states.hasOwnProperty(countryKey)) {
        // We have states for this country, show the states drop down.
        $states.classList.remove('hidden');
        $states.setAttribute('name', $states.dataset.modelname + '[stateValue]');

        // We have states for this country, hide the administrativeArea input.
        $administrativeArea.removeAttribute('name');
        $administrativeArea.classList.add('hidden');
        $administrativeArea.value = '';

        // Add all states as options to drop down.
        for (var id in window.states[countryKey]) {
          var state = window.states[countryKey][id];
          var $option = document.createElement('OPTION');
          $option.text = state;
          $option.value = id.replace('state-', '');
          $states.appendChild($option);
        }
      } else {
        // hide the states dropdown, since this country has none.
        $states.classList.add('hidden');
        $states.removeAttribute('name');

        // show the administrativeArea
        $administrativeArea.classList.remove('hidden');
        $administrativeArea.setAttribute('name', $administrativeArea.dataset.modelname + '[stateValue]');
      }
    });
  });
{% endjs %}
{% endif %}
