{% extends 'shop/_private/layouts' %}

{% block main %}
  <!-- Template: {{ _self }}.twig -->
  <div class="mx-auto max-w-md rounded-lg border border-gray-200 bg-white p-6 shadow-xs sm:p-8">
    <h1 class="text-xl font-semibold">{{ 'Reset your password'|t }}</h1>
    <p class="mt-1 text-sm text-gray-500">{{ 'Enter your username or email and we’ll send you a link to reset your password.'|t }}</p>

    <form method="post" accept-charset="UTF-8" class="mt-6 space-y-5">
      {{ csrfInput() }}
      {{ actionInput('users/send-password-reset-email') }}
      {{ redirectInput('shop/checkout/register-signin') }}

      <div>
        <label for="loginName" class="block text-sm font-medium text-gray-700">{{ 'Username or email'|t }}</label>
        {{ input('text', 'loginName', old('loginName', AuthMethods.getRememberedUsername()), {
          id: 'loginName',
          autocomplete: 'username',
          class: 'mt-1 w-full block rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600'
        }) }}
        {% if errors.any() %}
          {{ ul(errors.all(), { class: 'mt-2 space-y-1 text-sm text-red-600' }) }}
        {% endif %}
      </div>

      {{ tag('button', {
        type: 'submit',
        class: 'w-full inline-flex cursor-pointer items-center justify-center gap-2 rounded-md px-4 py-2.5 text-sm font-semibold shadow-xs transition focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-blue-600 text-white hover:bg-blue-500 focus-visible:outline-blue-600',
        text: 'Send reset link'|t
      }) }}
    </form>

    <p class="mt-6 text-center text-sm text-gray-500">
      <a href="{{ url('shop/customer/sign-in') }}" class="font-medium text-blue-600 hover:text-blue-500">{{ 'Back to sign in'|t }}</a>
    </p>
  </div>
{% endblock %}
