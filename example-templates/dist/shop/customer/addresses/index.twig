{% extends 'shop/_private/layouts' %}

{% if not currentUser %}
  {% exit 404 %}
{% endif %}

{# @var primaryBillingAddress \CraftCms\Cms\Address\Elements\Address #}
{% set primaryBillingAddress = currentUser.getPrimaryBillingAddress() %}
{# @var primaryShippingAddress \CraftCms\Cms\Address\Elements\Address #}
{% set primaryShippingAddress = currentUser.getPrimaryShippingAddress() %}

{% block main %}
  <!-- Template: {{ _self }}.twig -->
  <h1 class="text-3xl font-bold tracking-tight">{{ 'Addresses'|t }}</h1>
  <p class="mt-1 text-sm text-gray-500">{{ 'Manage the addresses you use at checkout.'|t }}</p>

  <div class="mt-6">
    {{ include('shop/_private/address/list', {
      addresses: currentUser.addresses,
      selectable: false,
      primaryBillingAddressId: currentUser.primaryBillingAddressId,
      primaryShippingAddressId: currentUser.primaryShippingAddressId,
      showDelete: true,
      showAdd: true
    }) }}
  </div>
{% endblock %}
