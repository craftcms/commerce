<form method="post" action="" accept-charset="UTF-8" class="mt-6 space-y-5">
  {{ csrfInput() }}
  {{ actionInput('users/login') }}
  {{ redirectInput(redirectUrl ?? '') }}

  <div>
    <label for="loginName" class="block text-sm font-medium text-gray-700">{{ 'Email or username'|t }}</label>
    {{ input('text', 'loginName', old('loginName', AuthMethods.getRememberedUsername()), {
      id: 'loginName',
      autocomplete: 'username',
      required: true,
      class: 'mt-1 w-full block rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600'
    }) }}
  </div>

  <div>
    <div class="flex items-center justify-between">
      <label for="loginPassword" class="block text-sm font-medium text-gray-700">{{ 'Password'|t }}</label>
      <a href="{{ url('/shop/customer/forgot-password') }}" class="text-sm font-medium text-blue-600 hover:text-blue-500">{{ 'Forgot password?'|t }}</a>
    </div>
    {{ input('password', 'password', null, {
      id: 'loginPassword',
      autocomplete: 'current-password',
      class: 'mt-1 w-full block rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600'
    }) }}
  </div>

  <label class="flex items-center gap-2 text-sm text-gray-700">
    {{ input('checkbox', 'rememberMe', 1, { class: 'size-4' }) }}
    {{ 'Remember me'|t }}
  </label>

  {{ tag('button', {
    type: 'submit',
    class: 'w-full inline-flex cursor-pointer items-center justify-center gap-2 rounded-md px-4 py-2.5 text-sm font-semibold shadow-xs transition focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-blue-600 text-white hover:bg-blue-500 focus-visible:outline-blue-600',
    text: 'Sign in'|t
  }) }}
</form>
