{% extends 'shop/_private/layouts' %}

{% if cart is defined and cart.availableShippingMethodOptions|length < 2 and cart.shippingMethod %}
  {% redirect 'shop/checkout/payment-method' %}
{% endif %}

{% block main %}
  <!-- Template: {{ _self }}.twig -->
  <div class="lg:grid lg:grid-cols-12 lg:items-start lg:gap-x-12">
    <div class="space-y-8 rounded-lg border border-gray-200 bg-white p-6 shadow-xs sm:p-8 lg:col-span-7">
      <h1 class="text-xl font-semibold">
        {{- 'How should your order be shipped?'|t -}}
      </h1>

      {% if not cart.availableShippingMethodOptions|length %}
        <p class="my-3">
          {{- 'No shipping methods available.'|t -}}
        </p>
        <div>
          <a href="{{ url('/shop/checkout/payment-method') }}"
             class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-md px-4 py-2.5 text-sm font-semibold shadow-xs transition focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-blue-600 text-white hover:bg-blue-500 focus-visible:outline-blue-600"
          >
            {{- 'Continue to payment method'|t -}}
          </a>
        </div>
      {% else %}
        <div class="mt-3">
          <form method="post">
            {{ csrfInput() }}
            {{ actionInput('commerce/cart/update') }}
            {{ redirectInput(siteUrl('shop/checkout/payment-method')) }}
            {{ successMessageInput('Shipping option updated.') }}

            <div class="space-y-3">
              {% for handle, method in cart.availableShippingMethodOptions %}
                <div class="js-shipping-select">
                  <label class="flex items-center gap-4 block cursor-pointer rounded-lg border border-gray-200 bg-white px-4 py-3 shadow-xs hover:border-gray-300 has-checked:border-blue-600 has-checked:ring-1 has-checked:ring-blue-600">
                    {{ input('radio', 'shippingMethodHandle', handle, {
                      checked: handle == cart.shippingMethodHandle,
                      class: 'size-4'
                    }) }}
                    <span class="flex-1 text-sm font-medium">{{ method.name }}</span>
                    <span class="text-sm font-semibold tabular-nums">{{ method.getPrice()|commerceCurrency(cart.currency) }}</span>
                  </label>
                </div>
              {% endfor %}
            </div>
            <span class="mt-2 block text-sm text-red-600">{{ errors.get('shippingMethodHandle')|join }}</span>

            <div class="mt-6 flex justify-end gap-3">
              {{ tag('button', {
                type: 'submit',
                class: 'inline-flex cursor-pointer items-center justify-center gap-2 rounded-md px-4 py-2.5 text-sm font-semibold shadow-xs transition focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-blue-600 text-white hover:bg-blue-500 focus-visible:outline-blue-600',
                text: 'Continue to payment'|t
              }) }}
            </div>
          </form>
        </div>
      {% endif %}
    </div>
    <div class="mt-10 lg:col-span-5 lg:mt-0">
      {{ include('shop/checkout/_includes/order-summary', {
        showShippingAddress: true
      }) }}
    </div>
  </div>

{% endblock %}
