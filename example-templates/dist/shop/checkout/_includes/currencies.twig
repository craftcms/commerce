<!-- Template: {{ _self }}.twig -->
{#
Outputs radio inputs for currency selection.
#}

{# @var currencies \CraftCms\Commerce\Payment\Data\PaymentCurrency[] #}
{% set currencies = craft.commerce.paymentCurrencies.allPaymentCurrencies %}
{# @var cart \CraftCms\Commerce\Order\Elements\Order #}
{% set cart = cart is not defined ? craft.commerce.carts.cart : cart %}

{% if currencies|length > 1 %}
  <fieldset>
    <legend class="text-sm font-medium text-gray-700">{{ 'Payment currency'|t }}</legend>
    <div class="mt-3 grid gap-3 sm:grid-cols-2">
      {% for currency in currencies %}
        <label class="flex items-center gap-4 block cursor-pointer rounded-lg border border-gray-200 bg-white px-4 py-3 shadow-xs hover:border-gray-300 has-checked:border-blue-600 has-checked:ring-1 has-checked:ring-blue-600">
          {{ input('radio', 'paymentCurrency', currency.iso, {
            checked: currency.iso == cart.paymentCurrency,
            class: 'size-4'
          }) }}
          <span class="flex-1">
            <span class="block text-sm font-medium">{{ currency.iso }}</span>
            <span class="block text-xs text-gray-500">{{ cart.outstandingBalance|commerceCurrency(currency.iso, convert=true) }}</span>
          </span>
        </label>
      {% endfor %}
    </div>
  </fieldset>
{% elseif currencies|length == 1 %}
  {# If there's only one currency, include it as a hidden field #}
  {{ hiddenInput('paymentCurrency', currencies[0].iso) }}
{% endif %}
