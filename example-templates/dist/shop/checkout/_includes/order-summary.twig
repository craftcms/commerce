<!-- Template: {{ _self }}.twig -->
{#
Outputs the checkout’s order summary: line items, the shipping address and method, and the cost breakdown.

@var cart \CraftCms\Commerce\Order\Elements\Order
#}
{% set showShippingAddress = showShippingAddress ?? false %}
{% set showShippingMethod = showShippingMethod ?? false %}

<section class="rounded-lg border border-gray-200 bg-white p-6 shadow-xs lg:sticky lg:top-6" aria-labelledby="order-summary-heading">
  <h2 id="order-summary-heading" class="text-lg font-semibold">{{ 'Order summary'|t }}</h2>

  <ul class="mt-4 divide-y divide-gray-200 text-sm">
    {% for item in cart.lineItems %}
      <li class="flex items-start gap-4 py-3">
        <div class="size-12 shrink-0 overflow-hidden rounded-md bg-gray-100">
          {% include "shop/_private/images/placeholder.svg" with { class: 'h-full w-full', width: 48, height: 48, showDimensions: false } %}
        </div>
        <div class="min-w-0 flex-1">
          <p class="truncate font-medium">{{ item.description }}</p>
          <p class="text-gray-500">{{ 'Qty {qty}'|t({ qty: item.qty }) }}</p>
        </div>
        <p class="font-medium tabular-nums">{{ item.subtotal|currency(cart.currency) }}</p>
      </li>
    {% else %}
      <li class="py-3 text-gray-500">
        {{ 'Nothing in your cart yet, <a href="{url}" class="{anchorClasses}">add something</a>.'|t({
          url: url('/shop/products'),
          anchorClasses: 'font-medium text-blue-600 hover:text-blue-500'
        })|raw }}
      </li>
    {% endfor %}
  </ul>

  {% if showShippingAddress or showShippingMethod %}
    <div class="mt-2 space-y-4 border-t border-gray-200 pt-4 text-sm">
      {% if showShippingAddress %}
        <div>
          <div class="flex items-center justify-between">
            <h3 class="font-medium">{{ 'Shipping to'|t }}</h3>
            <a href="{{ url('/shop/checkout/addresses') }}" class="font-medium text-blue-600 hover:text-blue-500">{{ 'Change'|t }}</a>
          </div>
          <div class="mt-1 text-gray-600 [&_p]:m-0">
            {% if cart.shippingAddress %}
              {{ Addresses.formatAddress(cart.shippingAddress)|raw }}
            {% else %}
              {{ 'No shipping address selected.'|t }}
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if showShippingMethod %}
        <div>
          <div class="flex items-center justify-between">
            <h3 class="font-medium">{{ 'Shipping method'|t }}</h3>
            <a href="{{ url('/shop/checkout/shipping') }}" class="font-medium text-blue-600 hover:text-blue-500">{{ cart.shippingMethodName ? 'Change'|t : 'Choose'|t }}</a>
          </div>
          <p class="mt-1 text-gray-600">{{ cart.shippingMethodName ?: 'None selected.'|t }}</p>
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="mt-4 border-t border-gray-200 pt-4">
    {{ include('shop/_private/order/totals', { order: cart }) }}
  </div>
</section>
