{% extends 'shop/_private/layouts' %}

{% set extraHead %}
  <meta name="robots" content="noindex">
  <meta name="referrer" content="same-origin">
{% endset %}

{# @var number string #}
{% set number = Request.get('number') %}
{# @var email string #}
{% set email = Request.get('email') %}
{# @var paymentMethod string #}
{% set paymentMethod = Request.get('paymentMethod') %}
{# @var gatewayId string #}
{% set gatewayId = Request.get('gatewayId') %}
{# @var paymentSourceId string #}
{% set paymentSourceId = Request.get('paymentSourceId') %}
{# @var paymentCurrency string #}
{% set paymentCurrency = Request.get('paymentCurrency') %}
{# @var url string #}
{% set url = 'shop/checkout/pay-static' %}

{% set cart = null %}
{% if number and email %}
  {# @var cart \CraftCms\Commerce\Order\Elements\Order #}
  {% set cart = craft.orders()
    .number(number)
    .email(email)
    .one() ?? null %}
{% endif %}

{# @var currentUserIsCartUser string #}
{% set currentUserIsCartUser = cart and cart.customerId and currentUser and currentUser.id == cart.customerId %}

{% block main %}
  <!-- Template: {{ _self }}.twig -->

  <div class="{{ cart ? 'lg:grid lg:grid-cols-12 lg:items-start lg:gap-x-12' : 'mx-auto max-w-md' }}">
    <div class="space-y-8 rounded-lg border border-gray-200 bg-white p-6 shadow-xs sm:p-8 {{ cart ? 'lg:col-span-7' }}">

      <h1 class="text-xl font-semibold">
        {{- 'Payment'|t -}}
      </h1>

      {% if (not number or not email) or (number and email and (not cart or (cart and not cart.hasOutstandingBalance))) %}
        {% if number and email and (not cart or (cart and not cart.hasOutstandingBalance)) %}
          <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
            <div>
              {% if cart and not cart.hasOutstandingBalance %}
                {{ 'No outstanding balance on this order.'|t }}
              {% else %}
                {{ 'Unable to retrieve order.'|t }}
              {% endif %}
            </div>
          </div>
        {% endif %}

        <p class="text-sm text-gray-500">{{ 'Enter your order number and the email address used to place the order.'|t }}</p>

        <form method="get" class="space-y-4">
          <div>
            <label for="number" class="block text-sm font-medium text-gray-700">
              {{- 'Order number'|t -}}
            </label>
            <div>
              {{ input('text', 'number', number, {
                id: 'number',
                class: ['mt-1', 'w-full', 'block rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600']
              }) }}
            </div>
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700">
              {{- 'Email address'|t -}}
            </label>
            <div>
              {{ input('email', 'email', email, {
                id: 'email',
                class: ['mt-1', 'w-full', 'block rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600']
              }) }}
            </div>
          </div>
          <div class="mt-6 flex justify-end gap-3">
            {{ tag('button', {
              type: 'submit',
              class: 'inline-flex cursor-pointer items-center justify-center gap-2 rounded-md px-4 py-2.5 text-sm font-semibold shadow-xs transition focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-blue-600 text-white hover:bg-blue-500 focus-visible:outline-blue-600',
              text: 'Find order'|t
            }) }}
          </div>
        </form>
      {% else %}
        {% if not gatewayId and not paymentSourceId %}
          {% set paymentSources = [] %}

          {% if currentUserIsCartUser %}
            {% set paymentSources = craft.commerce.paymentSources.getAllPaymentSourcesByCustomerId(currentUser.id) %}
          {% endif %}

          {% set availableGateways = cart.availableGateways %}

          {% if availableGateways|length %}
            <form action="" method="get" class="space-y-8">
              {{ hiddenInput('number', number) }}
              {{ hiddenInput('email', email) }}

              <div>
                {{ include('shop/checkout/_includes/gateways', {
                  availableGateways: availableGateways,
                  paymentSources: paymentSources
                }) }}
              </div>

              {{ include('shop/checkout/_includes/currencies') }}

              <div class="flex items-center justify-between gap-3">
                <a href="{{ siteUrl(url) }}" class="inline-flex cursor-pointer items-center justify-center gap-2 rounded-md px-4 py-2.5 text-sm font-semibold shadow-xs transition focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-white text-gray-900 ring-1 ring-gray-300 ring-inset hover:bg-gray-50">
                  {{- 'Back'|t -}}
                </a>
                {{ tag('button', {
                  type: 'submit',
                  class: 'inline-flex cursor-pointer items-center justify-center gap-2 rounded-md px-4 py-2.5 text-sm font-semibold shadow-xs transition focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-blue-600 text-white hover:bg-blue-500 focus-visible:outline-blue-600',
                  text: 'Continue'|t
                }) }}
              </div>
            </form>
          {% endif %}
        {% else %}
          {# Set payment currency, using cart's existing currency as fallback #}
          {% set finalPaymentCurrency = paymentCurrency ?? cart.paymentCurrency %}
          {% do cart.setPaymentCurrency(finalPaymentCurrency) %}
          {% set canPay = true %}
          <div>
            <form id="paymentForm"
                  method="post"
                  action=""
            >
              {{ csrfInput() }}
              {{ hiddenInput('action', 'commerce/payments/pay') }}
              {{ redirectInput('shop/customer/order?number=' ~ cart.number ~ '&success=true') }}
              {{ hiddenInput('cancelUrl', Request.getRequestUri()|hash) }}
              {{ hiddenInput('email', email) }}
              {{ hiddenInput('number', cart.number) }}
              {{ hiddenInput('paymentCurrency', finalPaymentCurrency) }}

              <fieldset class="space-y-6">
                {% if gatewayId %}
                  {# @var gateway \CraftCms\Commerce\Payment\Gateway\Contracts\GatewayInterface #}
                  {% set gateway = craft.commerce.gateways.getGatewayById(gatewayId) ?? null %}

                  {% if not gateway %}
                    {% set canPay = false %}
                    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
                      <div>
                        {{ 'Unable to retrieve gateway.'|t }}
                      </div>
                    </div>
                  {% else %}
                    {{ hiddenInput('gatewayId', gateway.id) }}

                    {% set params = {} %}

                    {% if className(gateway) == 'craft\\commerce\\paypalcheckout\\gateways\\Gateway' %}
                      {% set params = { currency: cart.paymentCurrency } %}
                    {% endif %}

                    {% if className(cart.gateway) == 'craft\\commerce\\stripe\\gateways\\PaymentIntents' %}
                      {% set params = {
                        appearance: {
                          theme: 'stripe'
                        },
                        elementOptions: {
                          layout: {
                            type: 'accordion',
                            defaultCollapsed: false,
                            radios: false,
                            spacedAccordionItems: false
                          }
                        },
                        order: cart,
                        submitButtonClasses: 'w-full inline-flex cursor-pointer items-center justify-center gap-2 rounded-md px-4 py-2.5 text-sm font-semibold shadow-xs transition focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-blue-600 text-white hover:bg-blue-500 focus-visible:outline-blue-600',
                        submitButtonText: 'Pay',
                        errorMessageClasses: 'rounded-md bg-red-50 p-3 text-sm text-red-700',
                      } %}
                    {% endif %}

                    <a href="{{ siteUrl(url, {
                      number: number,
                      email: email,
                    }) }}" class="font-medium text-blue-600 hover:text-blue-500">&larr; {{ 'Back'|t }}</a>

                    <div class="gateway-payment-form space-y-4 [&_craft-input]:block [&_fieldset]:space-y-1 [&_legend]:mb-1 [&_legend]:text-sm [&_legend]:font-medium [&_legend]:text-gray-700 [&_input:not([type=checkbox]):not([type=radio]):not([type=hidden])]:block [&_input:not([type=checkbox]):not([type=radio]):not([type=hidden])]:w-full [&_input:not([type=checkbox]):not([type=radio]):not([type=hidden])]:rounded-md [&_input:not([type=checkbox]):not([type=radio]):not([type=hidden])]:bg-white [&_input:not([type=checkbox]):not([type=radio]):not([type=hidden])]:px-3 [&_input:not([type=checkbox]):not([type=radio]):not([type=hidden])]:py-2 [&_input:not([type=checkbox]):not([type=radio]):not([type=hidden])]:text-sm [&_input:not([type=checkbox]):not([type=radio]):not([type=hidden])]:outline-1 [&_input:not([type=checkbox]):not([type=radio]):not([type=hidden])]:-outline-offset-1 [&_input:not([type=checkbox]):not([type=radio]):not([type=hidden])]:outline-gray-300 [&_input:not([type=checkbox]):not([type=radio]):not([type=hidden])]:focus:outline-2 [&_input:not([type=checkbox]):not([type=radio]):not([type=hidden])]:focus:outline-blue-600">
                      {% namespace gateway.handle|commercePaymentFormNamespace %}
                        {{ gateway.getPaymentFormHtml(params)|raw }}
                      {% endnamespace %}
                    </div>

                    {% if gateway.supportsPaymentSources() and currentUserIsCartUser %}
                      <label class="flex items-center gap-2 text-sm text-gray-700">
                        {{ input('checkbox', 'savePaymentSource', 1, { class: 'size-4' }) }}
                        {{ 'Save card for future purchases'|t }}
                      </label>
                    {% endif %}
                  {% endif %}

                {% elseif paymentSourceId %}
                  {% set paymentSource = craft.commerce.paymentSources.getPaymentSourceById(paymentSourceId) ?? null %}
                  {% if not paymentSource or not currentUserIsCartUser %}
                    {% set canPay = false %}
                    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" role="alert">
                      <div>
                        {{ 'Payment source not applicable for current user.'|t }}
                      </div>
                    </div>
                  {% else %}
                    <p class="text-sm">{{ 'Pay with'|t }} <span class="font-medium">{{ paymentSource.description }}</span></p>
                    {{ hiddenInput('paymentSourceId', paymentMethodParts[1]) }}
                  {% endif %}
                {% endif %}

                {% if canPay %}
                  {{ include('shop/checkout/_includes/partial-payment') }}

                  {% if cart.paymentSourceId or cart.gateway.showPaymentFormSubmitButton() %}
                    {{ tag('button', {
                      type: 'submit',
                      class: 'mt-6 w-full py-3 text-base inline-flex cursor-pointer items-center justify-center gap-2 rounded-md px-4 py-2.5 text-sm font-semibold shadow-xs transition focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-blue-600 text-white hover:bg-blue-500 focus-visible:outline-blue-600',
                      text: 'Pay now'|t
                    }) }}
                  {% endif %}
                {% endif %}
              </fieldset>
            </form>
          </div>
        {% endif %}
      {% endif %}
    </div>

    {% if cart %}
      <div class="mt-10 lg:col-span-5 lg:mt-0">
        {{ include('shop/checkout/_includes/order-summary', {
          showShippingAddress: true,
          showShippingMethod: true,
          cart: cart
        }) }}
      </div>
    {% endif %}
  </div>

  {% js %}
    let paymentForm = document.querySelector('#paymentForm');

    paymentForm.addEventListener('submit', function(ev) {
      if (paymentForm.dataset.processing) {
        ev.preventDefault();
        return false;
      }

      paymentForm.dataset.processing = 'true';
    });
  {% endjs %}
{% endblock %}
