{% extends 'shop/_private/layouts' %}

{# @var product \CraftCms\Commerce\Product\Elements\Product #}

{% block main %}
  <!-- Template: {{ _self }}.twig -->
  <nav class="text-sm text-gray-500" aria-label="{{ 'Breadcrumb'|t }}">
    <a href="{{ url('shop/products') }}" class="hover:text-gray-700">{{ 'Products'|t }}</a>
    <span class="mx-2" aria-hidden="true">/</span>
    <span class="text-gray-900">{{ product.title }}</span>
  </nav>

  <div class="mt-6 grid gap-10 lg:grid-cols-2">
    <div class="overflow-hidden rounded-lg">
      {% include "shop/_private/images/placeholder.svg" with {
        class: 'block h-auto w-full',
        width: 625,
        height: 500
      } %}
    </div>

    <div>
      <h1 class="text-3xl font-bold tracking-tight">{{ product.title }}</h1>
      <p class="mt-3 text-2xl text-gray-900">{{ product.defaultPriceAsCurrency }}</p>

      <p class="mt-6 text-gray-600">
        {{ 'This is a pretend product description, placeholdering here for you to swap with something better.'|t }}
      </p>

      <form method="post" class="mt-8">
        {{ csrfInput() }}
        {{ actionInput('commerce/cart/update') }}
        {{ successMessageInput('{product} added to cart.'|t({
          product: product.title
        })) }}

        <fieldset>
          <legend class="text-sm font-semibold">{{ 'Choose quantities'|t }}</legend>
          <ul class="mt-3 divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
            {% for variant in product.variants %}
              {# @var variant \CraftCms\Commerce\Product\Variant\Elements\Variant #}
              {% set inputId = 'qty-' ~ variant.id %}
              {{ hiddenInput('purchasables[' ~ loop.index ~ '][id]', variant.id) }}
              <li class="flex items-center gap-4 px-4 py-3">
                <label for="{{ inputId }}" class="flex-1">
                  <span class="block text-sm font-medium">{{ variant.title }}</span>
                  <span class="block font-mono text-xs text-gray-500">{{ variant.sku }}</span>
                  {% if variant.hasInventory and variant.inventoryTracked %}
                    <span class="block text-xs {{ variant.stock ? 'text-green-700' : 'text-red-600' }}">
                      {{ variant.stock ? '{stock} in stock'|t({ stock: variant.stock }) : 'Out of stock'|t }}
                    </span>
                  {% endif %}
                </label>
                <p class="text-right text-sm">
                  {% if variant.onPromotion %}
                    <del class="block text-gray-400">{{ variant.priceAsCurrency }}</del>
                    <span class="font-semibold text-red-600">{{ variant.salePriceAsCurrency }}</span>
                  {% else %}
                    <span class="font-semibold">{{ variant.priceAsCurrency }}</span>
                  {% endif %}
                </p>
                {{ input('number', 'purchasables[' ~ loop.index ~ '][qty]', product.variants|length == 1 ? 1 : 0, {
                  id: inputId,
                  step: 1,
                  min: 0,
                  disabled: not variant.availableForPurchase,
                  class: 'w-20 block rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600'
                }) }}
              </li>
            {% endfor %}
          </ul>
        </fieldset>

        {{ tag('button', {
          type: 'submit',
          class: 'mt-6 w-full inline-flex cursor-pointer items-center justify-center gap-2 rounded-md px-4 py-2.5 text-sm font-semibold shadow-xs transition focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-blue-600 text-white hover:bg-blue-500 focus-visible:outline-blue-600 py-3 text-base',
          text: 'Add to cart'|t
        }) }}
      </form>
    </div>
  </div>
{% endblock %}
