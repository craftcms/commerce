<!-- Template: {{ _self }}.twig -->
{# @var products  \CraftCms\Commerce\Product\Elements\Product[] #}
{# @var pageInfo  \CraftCms\Cms\Twig\Variables\Paginate #}
{% set linkClasses = 'inline-flex min-w-9 items-center justify-center rounded-md px-3 py-2 text-sm font-medium text-gray-700 ring-1 ring-gray-300 ring-inset hover:bg-gray-50' %}
<nav class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-gray-200 pt-6 sm:flex-row" aria-label="{{ 'Pagination'|t }}">
  <p class="text-sm text-gray-500">
    {{ 'Showing {first}–{last} of {total}'|t({
      first: pageInfo.first,
      last: pageInfo.last,
      total: pageInfo.total
    }) }}
  </p>

  {% if pageInfo.totalPages > 1 %}
    <div class="flex items-center gap-1">
      {% if pageInfo.prevUrl %}
        <a href="{{ pageInfo.prevUrl }}" class="{{ linkClasses }}">{{ 'Previous'|t }}</a>
      {% endif %}

      {% for page, url in pageInfo.getPrevUrls(3) %}
        <a href="{{ url }}" class="{{ linkClasses }}">{{ page }}</a>
      {% endfor %}

      <span class="inline-flex min-w-9 items-center justify-center rounded-md bg-blue-600 px-3 py-2 text-sm font-semibold text-white" aria-current="page">
        {{- pageInfo.currentPage -}}
      </span>

      {% for page, url in pageInfo.getNextUrls(3) %}
        <a href="{{ url }}" class="{{ linkClasses }}">{{ page }}</a>
      {% endfor %}

      {% if pageInfo.nextUrl %}
        <a href="{{ pageInfo.nextUrl }}" class="{{ linkClasses }}">{{ 'Next'|t }}</a>
      {% endif %}
    </div>
  {% endif %}
</nav>
