{% extends 'shop/_private/layouts' %}

{% set searchTerm = Request.query('search') %}

{% block main %}
  <!-- Template: {{ _self }}.twig -->
  <div class="flex flex-col gap-4 border-b border-gray-200 pb-6 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">{{ 'Products'|t }}</h1>
      <p class="mt-1 text-sm text-gray-500">{{ 'Browse the catalog and add items to your cart.'|t }}</p>
    </div>
    <form action="" method="get" role="search" class="flex w-full gap-2 sm:max-w-sm">
      <label for="search" class="sr-only">{{ 'Search products'|t }}</label>
      {{ tag('input', {
        id: 'search',
        name: 'search',
        type: 'search',
        placeholder: 'Search products…'|t,
        value: searchTerm,
        class: 'w-full block rounded-md bg-white px-3 py-2 text-sm text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-blue-600',
      }) }}
      {{ tag('button', {
        type: 'submit',
        class: 'inline-flex cursor-pointer items-center justify-center gap-2 rounded-md px-4 py-2.5 text-sm font-semibold shadow-xs transition focus-visible:outline-2 focus-visible:outline-offset-2 disabled:cursor-not-allowed disabled:opacity-50 bg-blue-600 text-white hover:bg-blue-500 focus-visible:outline-blue-600',
        text: 'Search'|t
      }) }}
    </form>
  </div>

  {% paginate craft.products.limit(12).search(searchTerm) as pageInfo, pageProducts %}

  {% if pageProducts|length %}
    {{ include('shop/products/_includes/grid', {
      products: pageProducts
    }) }}
  {% else %}
    <div class="mt-10 rounded-lg border border-dashed border-gray-300 p-12 text-center">
      <p class="font-semibold">{{ 'No products found'|t }}</p>
      <p class="mt-1 text-sm text-gray-500">
        {{ searchTerm ? 'Try a different search term.'|t : 'Products you create will appear here.'|t }}
      </p>
    </div>
  {% endif %}

  {{ include('shop/products/_includes/pagination', {
    products: pageProducts,
    pageInfo: pageInfo
  }) }}
{% endblock %}
