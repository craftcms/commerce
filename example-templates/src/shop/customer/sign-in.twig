{% extends '[[folderName]]/_private/layouts' %}

{% set extraHead %}
  <meta name="robots" content="noindex">
{% endset %}

{% block main %}
  <!-- Template: {{ _self }}.twig -->
  <div class="mx-auto max-w-md rounded-lg border border-gray-200 bg-white p-6 shadow-xs sm:p-8">
    <h1 class="text-xl font-semibold">{{ 'Sign in to your account'|t }}</h1>
    {% include '[[folderName]]/customer/_includes/sign-in' with {
      redirectUrl : '[[folderName]]/customer'
    } %}
  </div>
{% endblock %}
