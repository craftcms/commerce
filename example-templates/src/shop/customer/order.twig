{% extends '[[folderName]]/_private/layouts' %}

{% set number = Request.get('number') %}
{% if not number %}
  {% exit 400 %}
{% endif %}

{# @var order \CraftCms\Commerce\Order\Elements\Order #}
{% set order = craft.orders()
  .number(number)
  .one() %}

{% set extraHead %}
  <meta name="robots" content="noindex">
  <meta name="referrer" content="same-origin">
{% endset %}

{% if not order or order.isCompleted == false %}
  {% redirect '[[folderName]]/customer' %}
{% endif %}

{% block main %}
  <!-- Template: {{ _self }}.twig -->
  {% if currentUser %}
    <a href="{{ url('/[[folderName]]/customer') }}" class="text-sm [[classes.a]]">&larr; {{ 'Back to orders'|t }}</a>
  {% endif %}

  {% if Request.query('success') %}
    <div class="mt-6 rounded-lg border border-green-200 bg-green-50 p-6">
      <h2 class="text-lg font-semibold text-green-900">{{ 'Thanks for your order!'|t }}</h2>
      <p class="mt-1 text-sm text-green-800">{{ 'We’ve sent a confirmation to {email}.'|t({ email: order.email }) }}</p>
    </div>
  {% endif %}

  <div class="mt-6 flex flex-wrap items-end justify-between gap-4 border-b border-gray-200 pb-6">
    <div>
      <h1 class="text-3xl font-bold tracking-tight">{{ 'Order {ref}'|t({ ref: order.reference }) }}</h1>
      <p class="mt-1 text-sm text-gray-500">
        {{ 'Placed on {date}'|t({ date: order.dateOrdered|date }) }}
        <span class="ml-2 rounded-full px-2.5 py-0.5 text-xs font-medium {{ order.isPaid ? 'bg-green-50 text-green-700' : 'bg-amber-50 text-amber-700' }}">{{ order.paidStatus|title }}</span>
      </p>
    </div>
    {# Display a link to download a PDF if the order has a PDF URL and a PDF has been configured #}
    {% if craft.commerce.pdfs.hasEnabledPdf %}
      <a href="{{ order.getPdfUrl('receipt') }}" download target="_blank" class="[[classes.btn.base]] [[classes.btn.grayColor]]">
        {{- 'Download receipt'|t -}}
      </a>
    {% endif %}
  </div>

  <div class="mt-8 lg:grid lg:grid-cols-12 lg:items-start lg:gap-x-12">
    <div class="space-y-8 lg:col-span-7">
      <section aria-labelledby="items-heading">
        <h2 id="items-heading" class="text-lg font-semibold">{{ 'Items'|t }}</h2>
        <ul class="mt-4 divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white">
          {% for item in order.lineItems %}
            <li class="flex gap-4 p-4">
              <div class="size-16 shrink-0 overflow-hidden rounded-md bg-gray-100">
                {% include "[[folderName]]/_private/images/placeholder.svg" with { class: 'h-full w-full', width: 64, height: 64, showDimensions: false } %}
              </div>
              <div class="min-w-0 flex-1 text-sm">
                <div class="flex justify-between gap-4">
                  <div>
                    <p class="font-medium">{{ item.description }}</p>
                    <p class="font-mono text-xs text-gray-500">{{ item.sku }}</p>
                  </div>
                  <p class="font-medium tabular-nums">{{ item.totalAsCurrency }}</p>
                </div>
                <p class="mt-1 text-gray-500">
                  {{ 'Qty {qty}'|t({ qty: item.qty }) }} ·
                  {% if item.onPromotion %}<del>{{ item.priceAsCurrency }}</del> {{ item.promotionalPriceAsCurrency }}{% else %}{{ item.priceAsCurrency }}{% endif %}
                  {{ 'each'|t }}
                </p>
                {% if item.options|length %}
                  <ul class="mt-2 flex flex-wrap gap-1.5">
                    {% for key, value in item.options %}
                      <li class="rounded-md bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{{ key }}: {{ value is iterable ? value|json_encode : value }}</li>
                    {% endfor %}
                  </ul>
                {% endif %}
                {% if item.note %}
                  <p class="mt-2 text-gray-600"><span class="font-medium">{{ 'Note'|t }}:</span> {{ item.note }}</p>
                {% endif %}
                {% if item.adjustments|length %}
                  <ul class="mt-2 space-y-1 text-xs text-gray-500">
                    {% for adjustment in item.adjustments %}
                      <li class="flex justify-between gap-4">
                        <span><span class="font-medium uppercase">{{ adjustment.type }}</span> {{ adjustment.name }}</span>
                        <span class="tabular-nums">{{ adjustment.amountAsCurrency }}</span>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
      </section>

      <section aria-labelledby="transactions-heading">
        <h2 id="transactions-heading" class="text-lg font-semibold">{{ 'Transactions'|t }}</h2>
        {% if order.transactions|length %}
          <ul class="mt-4 divide-y divide-gray-200 rounded-lg border border-gray-200 bg-white text-sm">
            {% for transaction in order.transactions %}
              <li class="flex flex-wrap items-center justify-between gap-3 p-4 {{ transaction.getParent() ? 'pl-8' }}">
                <div class="flex items-center gap-3">
                  <span class="rounded-full px-2 py-0.5 text-xs font-medium {{ transaction.status == 'success' ? 'bg-green-50 text-green-700' : 'bg-gray-100 text-gray-600' }}">
                    {{- transaction.status|title -}}
                  </span>
                  <span>
                    <span class="font-medium">{{ transaction.amountAsCurrency }} {{ transaction.currency }}</span>
                    <span class="text-gray-500">{{ transaction.type }}</span>
                    {% if transaction.paymentCurrency != transaction.currency %}
                      <span class="block text-xs text-gray-500">({{ transaction.paymentAmountAsCurrency }} {{ transaction.paymentCurrency }} {{ 'paid'|t }})</span>
                    {% endif %}
                  </span>
                </div>
                <span class="text-gray-500">{{ transaction.dateCreated|datetime('short') }}</span>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="mt-2 text-sm text-gray-500">{{ 'No payments have been made yet.'|t }}</p>
        {% endif %}
      </section>
    </div>

    <aside class="mt-10 space-y-6 lg:col-span-5 lg:mt-0">
      <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-xs">
        <h2 class="text-lg font-semibold">{{ 'Summary'|t }}</h2>
        <div class="mt-4">
          {{ include('[[folderName]]/_private/order/totals', { order: order }) }}
        </div>
        <dl class="mt-3 space-y-3 border-t border-gray-200 pt-3 text-sm">
          <div class="flex items-center justify-between">
            <dt class="text-gray-600">{{ 'Paid'|t }}</dt>
            <dd class="font-medium tabular-nums">{{ order.totalPaidAsCurrency }}</dd>
          </div>
          <div class="flex items-center justify-between">
            <dt class="text-gray-600">{{ 'Balance due'|t }}</dt>
            <dd class="font-semibold tabular-nums">{{ order.outstandingBalanceAsCurrency }}</dd>
          </div>
        </dl>
        {% if order.getOutstandingBalance() - order.getTotalAuthorized() > 0 %}
          <a href="{{ siteUrl('[[folderName]]/checkout/pay-static', {
            number: order.number,
            email: order.email,
            paymentCurrency: order.paymentCurrency
          }) }}" class="mt-6 w-full [[classes.btn.base]] [[classes.btn.mainColor]]">
            {{- 'Pay remaining balance'|t -}}
          </a>
        {% endif %}
      </section>

      <section class="grid gap-6 rounded-lg border border-gray-200 bg-white p-6 text-sm shadow-xs sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        <div>
          <h2 class="font-semibold">{{ 'Shipping address'|t }}</h2>
          <div class="mt-2 text-gray-600 [&_p]:m-0">
            {{ order.shippingAddress ? Addresses.formatAddress(order.shippingAddress)|raw : 'Not provided.'|t }}
          </div>
        </div>
        <div>
          <h2 class="font-semibold">{{ 'Billing address'|t }}</h2>
          <div class="mt-2 text-gray-600 [&_p]:m-0">
            {{ order.billingAddress ? Addresses.formatAddress(order.billingAddress)|raw : 'Not provided.'|t }}
          </div>
        </div>
        <div>
          <h2 class="font-semibold">{{ 'Contact'|t }}</h2>
          <p class="mt-2 text-gray-600">{{ order.email }}</p>
        </div>
        {% if order.shippingMethodName %}
          <div>
            <h2 class="font-semibold">{{ 'Shipping method'|t }}</h2>
            <p class="mt-2 text-gray-600">{{ order.shippingMethodName }}</p>
          </div>
        {% endif %}
      </section>
    </aside>
  </div>
{% endblock %}
