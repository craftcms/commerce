{% extends '[[folderName]]/_private/layouts' %}

{% if not currentUser %}
    {% exit 404 %}
{% endif %}

{% block main %}

    {% set addressId = Request.query('addressId') %}
    {% set redirect = Request.query('redirect') %}
    {% set countryCode = Request.query('countryCode') %}

    {% if not address is defined %}
        {% if addressId %}
            {% set address = collect(currentUser.addresses).firstWhere('id', addressId) %}
            {% if not address %}
                {% exit 404 %}
            {% endif %}
        {% else %}
            {% set address = create({
                class: 'CraftCms\\Cms\\Address\\Elements\\Address',
                ownerId: currentUser.id,
                countryCode: countryCode ?? 'US'
            }) %}
        {% endif %}
    {% endif %}

  <!-- Template: {{ _self }}.twig -->
  <div class="mx-auto max-w-2xl rounded-lg border border-gray-200 bg-white p-6 shadow-xs sm:p-8">
    <h1 class="text-xl font-semibold">
      {{- addressId ? 'Edit address'|t : 'Add an address'|t -}}
    </h1>

    <form method="post" action="" class="mt-6">
      {{ csrfInput() }}
      {{ actionInput('users/save-address') }}
      {{ redirectInput(redirect ?: '[[folderName]]/customer/addresses') }}

      {% if addressId %}
        {{ hiddenInput('addressId', addressId) }}
      {% endif %}

      {{ include('[[folderName]]/_private/address/fields', {
        address: address,
        showLabelField: true,
        showPrimaryCheckboxes: true,
      }) }}
      {{ hiddenInput('ownerId', currentUser.id) }}

      <div class="mt-8 flex items-center justify-end gap-3 border-t border-gray-200 pt-6">
        <a href="{{ redirect ? '/' ~ redirect : url('[[folderName]]/customer/addresses') }}" class="[[classes.btn.base]] [[classes.btn.grayColor]]">
          {{- 'Cancel'|t -}}
        </a>
        {{ tag('button', {
          type: 'submit',
          class: '[[classes.btn.base]] [[classes.btn.mainColor]]',
          text: 'Save address'|t
        }) }}
      </div>
    </form>
  </div>
{% endblock %}