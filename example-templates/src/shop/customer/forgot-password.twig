{% extends '[[folderName]]/_private/layouts' %}

{% block main %}
  <!-- Template: {{ _self }}.twig -->
  <div class="mx-auto max-w-md rounded-lg border border-gray-200 bg-white p-6 shadow-xs sm:p-8">
    <h1 class="text-xl font-semibold">{{ 'Reset your password'|t }}</h1>
    <p class="mt-1 text-sm text-gray-500">{{ 'Enter your username or email and we’ll send you a link to reset your password.'|t }}</p>

    <form method="post" accept-charset="UTF-8" class="mt-6 space-y-5">
      {{ csrfInput() }}
      {{ actionInput('users/send-password-reset-email') }}
      {{ redirectInput('[[folderName]]/checkout/register-signin') }}

      <div>
        <label for="loginName" class="block text-sm font-medium text-gray-700">{{ 'Username or email'|t }}</label>
        {{ input('text', 'loginName', old('loginName', AuthMethods.getRememberedUsername()), {
          id: 'loginName',
          autocomplete: 'username',
          class: 'mt-1 w-full [[classes.input]]'
        }) }}
        {% if errors.any() %}
          {{ ul(errors.all(), { class: 'mt-2 space-y-1 text-sm text-[[dangerColor]]-600' }) }}
        {% endif %}
      </div>

      {{ tag('button', {
        type: 'submit',
        class: 'w-full [[classes.btn.base]] [[classes.btn.mainColor]]',
        text: 'Send reset link'|t
      }) }}
    </form>

    <p class="mt-6 text-center text-sm text-gray-500">
      <a href="{{ url('[[folderName]]/customer/sign-in') }}" class="[[classes.a]]">{{ 'Back to sign in'|t }}</a>
    </p>
  </div>
{% endblock %}
