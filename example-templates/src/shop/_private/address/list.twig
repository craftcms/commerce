{% set addresses = addresses ?? [] %}
{% set selectable = selectable ?? false %}
{% set primaryBillingAddressId = primaryBillingAddressId ?? null %}
{% set primaryShippingAddressId = primaryShippingAddressId ?? null %}
{% set showDelete = showDelete ?? false %}
{% set showAdd = showAdd ?? false %}
{% set addUrl = siteUrl('[[folderName]]/customer/addresses/edit?redirect=' ~ Request.path()) %}

{% if currentUser %}
  <div class="my-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
    {% for address in addresses %}
      {% set editUrl = '[[folderName]]/customer/addresses/edit?addressId=' ~ address.id ~ '&redirect=' ~ Request.path() %}
      {% tag selectable ? 'label' : 'div' with {
        class: ['address-select js-address-select relative flex flex-col justify-between gap-4 p-4 text-sm', selectable ? '[[classes.box.selection]]' : 'rounded-lg border border-gray-200 bg-white shadow-xs'],
        data: {
          'address-id': address.id,
        },
      } %}
        <span class="js-radio flex gap-3">
          {% if selectable %}
            {{ input('radio', name ~ 'Id', address.id, {
              class: 'mt-0.5 size-4 shrink-0',
              data: {
                'model-name': name,
              },
              checked: (attribute(cart, sourceIdName) == address.id) or (not attribute(cart, sourceIdName) and address.id == attribute(_context, primaryIdName)),
            }) }}
          {% endif %}
          <span class="text-gray-700 [&_p]:m-0">
            {% if address.title %}<span class="mb-1 block font-semibold text-gray-900">{{ address.title }}</span>{% endif %}
            {{ address|address }}
          </span>
        </span>

        <span class="flex flex-wrap items-center gap-2">
          {% if primaryShippingAddressId == address.id %}
            <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">{{ 'Default shipping'|t }}</span>
          {% endif %}
          {% if primaryBillingAddressId == address.id %}
            <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">{{ 'Default billing'|t }}</span>
          {% endif %}
          <span class="ml-auto flex gap-2">
            <a href="{{ url(editUrl) }}" class="[[classes.btn.small]] [[classes.btn.grayColor]]">{{ 'Edit'|t }}</a>
            {% if showDelete and not selectable %}
              <form method="post" action="" class="js-address-delete">
                {{ csrfInput() }}
                {{ actionInput('users/delete-address') }}
                {{ redirectInput('[[folderName]]/customer/addresses') }}
                {{ hiddenInput('addressId', address.id) }}
                {{ tag('button', {
                  type: 'submit',
                  class: '[[classes.btn.small]] [[classes.btn.grayColor]] text-[[dangerColor]]-600',
                  text: 'Delete'|t
                }) }}
              </form>
            {% endif %}
          </span>
        </span>
      {% endtag %}
    {% endfor %}
    {% if showAdd %}
      <a href="{{ addUrl }}" class="flex min-h-28 items-center justify-center gap-2 rounded-lg border-2 border-dashed border-gray-300 p-4 text-sm font-medium text-gray-600 hover:border-gray-400 hover:text-gray-900">
        <span aria-hidden="true">+</span> {{ 'Add an address'|t }}
      </a>
    {% endif %}
  </div>
{% endif %}

{% js %}
    const addressDeletes = document.querySelectorAll('.js-address-delete');
    for (let i = 0; i < addressDeletes.length; i++) {
        addressDeletes[i].addEventListener('submit', ev => {
            if (!confirm('{{ 'Are you sure you want to delete this address?'|t }}')) {
                ev.preventDefault();
            }
        });
    }
{% endjs %}
