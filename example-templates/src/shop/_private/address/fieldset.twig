<!-- Template: {{ _self }}.twig -->
{#
Outputs a fieldset for selecting one of a user’s available addresses or creating a new one.

@var addresses   \CraftCms\Cms\Address\Elements\Address[]
@var cart        \CraftCms\Commerce\Order\Elements\Order
@var classes     string
@var name        string
@var title       string
@var currentUser \CraftCms\Cms\User\Elements\User
#}
{% set sourceAttribute = 'source' ~ (name|slice(0, 1)|capitalize) ~ (name|slice(1) ~ 'Id') %}
<div class="js-address-fieldset {{ classes }}">
  <h2 class="text-base font-semibold">
    {{- title -}}
  </h2>

  {{ include('[[folderName]]/_private/address/list', {
    adresses: addresses,
    selectable: true,
    primaryBillingAddressId: cart and cart.customer ? cart.customer.primaryBillingAddressId : null,
    primaryShippingAddressId: cart and cart.customer ? cart.customer.primaryShippingAddressId : null,
    showAdd: true,
  }) }}

  <div class="js-address-select" data-model-name="{{ name }}">
    {% set addressHasErrors = errors.has(name) or errors.has(name ~ '.*') %}

    {# Show the custom toggle if there is a custom address on the order #}
    {% if currentUser and cart and attribute(cart, name ~ 'Id') and not attribute(cart, sourceAttribute) %}
      <div class="js-radio">
        <label class="flex items-center gap-2 text-sm text-gray-700">
          {{ input('radio', name ~ 'Id', '', {
            checked: true,
            class: 'size-4'
          }) }}
          {{ 'Custom {title}'|t({ title: title }) }}
        </label>
      </div>
    {% endif %}

    <div class="js-body{% if currentUser and not addressHasErrors %} hidden{% endif %}">
      {% if errors.has(name) %}<p class="mt-2 text-sm text-[[dangerColor]]-600">{{ errors.get(name)|join }}</p>{% endif %}
      {% namespace name %}
        {{ include('[[folderName]]/_private/address/fields', {
          address: attribute(cart, name),
          addressName: name
        }) }}
      {% endnamespace %}
    </div>
  </div>
</div>
