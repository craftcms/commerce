{#
Common, top-level layout template.

@var cart        \CraftCms\Commerce\Order\Elements\Order
@var extraHead   string
@var flashNotice string
@var flashError  string
#}
<!DOCTYPE html>
<html lang="{{ currentSite.language }}" class="h-full bg-gray-50">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{ siteName ~ ' Shop' }}</title>

  [[resourceTags]]

  {% if extraHead is defined %}
    {{ extraHead }}
  {% endif %}
</head>
<body class="flex min-h-full flex-col text-gray-900 antialiased accent-[[color]]-600">
{% if cart is not defined %}
  {% set cart = craft.commerce.carts.cart %}
{% endif %}

{% set flashNotice = session().get('success') ?? session().get('notice') %}
{% set flashError = session().get('error') %}

{% macro docs(text, link) %}
  {{ tag('a', {
    text: 'ℹ︎ ' ~ text,
    href: link,
    class: 'text-xs [[classes.docs]]',
    target: '_blank',
  }) }}
{% endmacro %}

<header class="border-b border-gray-200 bg-white">
  {{ include('[[folderName]]/_private/layouts/includes/header') }}
</header>
{{ include('[[folderName]]/_private/layouts/includes/nav-checkout') }}
{{ include('[[folderName]]/_private/layouts/includes/nav-customer') }}

<main class="flex-1">
  <div class="mx-auto max-w-7xl space-y-3 px-4 pt-6 empty:hidden sm:px-6 lg:px-8">
    {%- if flashNotice %}
      <div class="flex items-start gap-3 rounded-lg border border-[[color]]-200 bg-[[color]]-50 px-4 py-3 text-sm text-[[color]]-800" role="status">
        {{ flashNotice }}
      </div>
    {% endif -%}

    {%- if flashError %}
      <div class="flex items-start gap-3 rounded-lg border border-[[dangerColor]]-200 bg-[[dangerColor]]-50 px-4 py-3 text-sm text-[[dangerColor]]-800" role="alert">
        {{ flashError }}
      </div>
    {% endif -%}

    {%- if cart and cart.hasNotices() %}
      <div class="flex items-start justify-between gap-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800" role="status">
        <div>
          <p class="font-semibold">{{ 'Your cart was updated'|t }}</p>
          <ul class="mt-1 list-disc space-y-1 pl-5">
            {% for notice in cart.getNotices() %}
              <li data-type="{{ notice.type }}"
                  data-attribute="{{ notice.attribute }}"
                  data-message="{{ notice.message }}"
              >
                {{- notice -}}
              </li>
            {% endfor %}
          </ul>
        </div>
        <form method="post">
          {{ csrfInput() }}
          {{ actionInput('commerce/cart/update') }}
          {{ successMessageInput('Notices dismissed') }}
          {{ hiddenInput('clearNotices') }}
          {{ tag('button', {
            type: 'submit',
            class: '[[classes.btn.small]] [[classes.btn.grayColor]]',
            text: 'Dismiss'|t
          }) }}
        </form>
      </div>
    {% endif -%}

    {# A failed cart update redirects back with the cart's errors in the `errors` bag #}
    {%- if session().get('modelName') == 'cart' and errors.any() %}
      <div class="rounded-lg border border-[[dangerColor]]-200 bg-[[dangerColor]]-50 px-4 py-3 text-sm text-[[dangerColor]]-800" role="alert">
        <ul class="list-disc space-y-1 pl-5">
          {% for attribute, messages in errors.getMessages() %}
            {% for message in messages %}
              <li>{{ message }}</li>
            {% endfor %}
          {% endfor %}
        </ul>
      </div>
    {% endif -%}
  </div>

  {% block body %}
    <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
      {% block main %}{% endblock %}
    </div>
  {% endblock %}
</main>

<footer class="mt-16 border-t border-gray-200 bg-white">
  {{ include('[[folderName]]/_private/layouts/includes/footer') }}
</footer>
</body>
</html>
{% js at head %}
let states = {{ craft.commerce.getStores().getCurrentStore().settings.getAdministrativeAreasListByCountryCode()|json_encode|raw }};
{% set usedFields = {} %}
{% for countryCode in Addresses.getCountryRepository().getAll()|keys %}
	{% set usedFields = usedFields|merge({ (countryCode): Addresses.getUsedFields(countryCode)|merge([
      'fullName',
      'latLong',
      'organizationTaxId',
      'organization',
      'countryCode',
    ]) }) %}
{% endfor %}
let usedAddressFieldsByCountryCode = {{ usedFields|json_encode|raw }};
function hideAddressFields(selectorTemplate) {
  const fields = document.querySelectorAll('.' + selectorTemplate.replace('placeHolder', 'js-address-field'));
  if (!fields.length) {
    return;
  }

  for (let i = 0; i < fields.length; i++) {
    fields[i].classList.add('hidden');
  }
}

function showAddressField(fieldName, selectorTemplate) {
  const closestSelector = selectorTemplate;
  const field = document.querySelector('#' + selectorTemplate.replace('placeHolder', fieldName));
  if (!field) {
    return;
  }

  const fieldWrapper = field.closest('.' + closestSelector.replace('placeHolder', 'js-address-field'));
  if (!fieldWrapper) {
    return;
  }

  fieldWrapper.classList.remove('hidden');
}
{% endjs %}

{% js at endBody %}
let $siteSelector = document.querySelector('#js-site-selector');
if ($siteSelector) {
  $siteSelector.addEventListener('change', (ev) => window.location = ev.target.value);
}
{% endjs %}