<!-- Template: {{ _self }}.twig -->
{#
Outputs the main navigation, plus account and cart links, based on the current path and the `pages` array.

@var cart        \CraftCms\Commerce\Order\Elements\Order
@var currentUser \CraftCms\Cms\User\Elements\User
#}
{% set pages = [
  {
    label: 'Products',
    url: '[[folderName]]/products'
  },
  {
    label: 'Donations',
    url: '[[folderName]]/donations'
  }
] %}
{% set currentPath = Request.path() %}

<nav class="flex items-center gap-1" aria-label="{{ 'Main'|t }}">
  {% for page in pages %}
    {% set isActive = page.url in currentPath %}
    <a href="{{ url(page.url) }}"
       class="rounded-md px-3 py-2 text-sm font-medium {{ isActive ? 'bg-gray-100 text-gray-900' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900' }}"
       {% if isActive %}aria-current="page"{% endif %}>
      {{- page.label|t -}}
    </a>
  {% endfor %}
</nav>

<div class="ml-auto flex items-center gap-2">
  {% if currentUser %}
    <a href="{{ url('[[folderName]]/customer') }}" class="rounded-md px-3 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-900">
      {{- 'My account'|t -}}
    </a>
  {% else %}
    <a href="{{ url('[[folderName]]/customer/sign-in') }}" class="rounded-md px-3 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-900">
      {{- 'Sign in'|t -}}
    </a>
  {% endif %}

  <a href="{{ url('[[folderName]]/cart') }}" class="group relative inline-flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-900">
    <svg class="size-5 text-gray-400 group-hover:text-gray-500" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/></svg>
    <span>{{ 'Cart'|t }}</span>
    <span class="rounded-full bg-[[color]]-600 px-2 py-0.5 text-xs font-semibold text-white {{ cart.totalQty ? '' : 'hidden' }}">
      {{- cart.totalQty -}}
    </span>
    <span class="sr-only">{{ '{count} items in cart'|t({ count: cart.totalQty }) }}</span>
  </a>
</div>
