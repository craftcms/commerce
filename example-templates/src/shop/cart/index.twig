{% extends "[[folderName]]/_private/layouts" %}
{#
Outputs cart.

@var cart \CraftCms\Commerce\Order\Elements\Order
#}

{% block main %}
  {# A failed cart update redirects back with the cart's errors in the `errors` bag #}
  {% set cartHasErrors = session().get('modelName') == 'cart' and errors.any() %}

  <!-- Template: {{ _self }}.twig -->
  <h1 class="text-3xl font-bold tracking-tight">{{ 'Shopping cart'|t }}</h1>

  {% if cart.lineItems|length %}
    <form method="post" action="" class="mt-8 lg:grid lg:grid-cols-12 lg:items-start lg:gap-x-12">
      {{ csrfInput() }}
      {{ actionInput('commerce/cart/update') }}
      {{ successMessageInput('Cart updated.'|t) }}
      {{ redirectInput('[[folderName]]/cart') }}

      <section class="lg:col-span-7" aria-labelledby="cart-heading">
        <h2 id="cart-heading" class="sr-only">{{ 'Items in your cart'|t }}</h2>

        <ul class="divide-y divide-gray-200 border-y border-gray-200">
          {% for item in cart.lineItems %}
            {% set itemErrorKey = 'lineItems.' ~ loop.index0 %}
            {% set hasDonationAmount = item.options.donationAmount is defined %}
            <li class="flex gap-4 py-6 sm:gap-6">
              <div class="size-20 shrink-0 overflow-hidden rounded-md bg-gray-100 sm:size-28">
                {% include "[[folderName]]/_private/images/placeholder.svg" with { class: 'h-full w-full', width: 112, height: 112, showDimensions: false } %}
              </div>

              <div class="flex flex-1 flex-col gap-3">
                <div class="flex justify-between gap-4">
                  <div class="min-w-0">
                    <h3 class="font-medium {{ errors.has(itemErrorKey ~ '.*') ? 'text-[[dangerColor]]-600' }}">
                      {%- if item.purchasable and item.purchasable.url -%}
                        <a href="{{ item.purchasable.url }}" class="hover:text-[[color]]-600">{{ item.description }}</a>
                      {%- else -%}
                        {{ item.description }}
                      {%- endif -%}
                    </h3>
                    <p class="mt-1 font-mono text-xs text-gray-500">{{ item.sku }}</p>
                    {% if item.options|length %}
                      <ul class="mt-2 flex flex-wrap gap-1.5">
                        {% for key, value in item.options %}
                          <li class="rounded-md bg-gray-100 px-2 py-0.5 text-xs text-gray-600">{{ key }}: {{ value is iterable ? value|json_encode : value }}</li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>

                  {% if not cartHasErrors %}
                    <div class="shrink-0 text-right text-sm">
                      {% if item.onPromotion %}
                        <del class="block text-gray-400">{{ item.priceAsCurrency }}</del>
                        <span class="font-medium text-[[dangerColor]]-600">{{ item.salePriceAsCurrency }}</span>
                      {% else %}
                        <span class="font-medium">{{ item.priceAsCurrency }}</span>
                      {% endif %}
                      {% if item.qty > 1 %}
                        <span class="block text-xs text-gray-500">{{ '{subtotal} for {qty}'|t({ subtotal: item.subtotalAsCurrency, qty: item.qty }) }}</span>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>

                <div class="flex flex-wrap items-end gap-3">
                  {% if hasDonationAmount %}
                    <div>
                      <label for="lineitem-donationAmount-{{ item.id }}" class="block text-xs font-medium text-gray-600">{{ 'Donation amount'|t }}</label>
                      {{ input('text', 'lineItems[' ~ item.id ~ '][options][donationAmount]', item.options.donationAmount, {
                        id: 'lineitem-donationAmount-' ~ item.id,
                        class: 'mt-1 w-28 [[classes.input]]',
                        placeholder: 'Donation'|t
                      }) }}
                    </div>
                    {{ hiddenInput('lineItems[' ~ item.id ~ '][qty]', item.qty) }}
                  {% else %}
                    <div>
                      <label for="lineitem-qty-{{ item.id }}" class="block text-xs font-medium text-gray-600">{{ 'Quantity'|t }}</label>
                      {{ input('number', 'lineItems[' ~ item.id ~ '][qty]', item.qty, {
                        id: 'lineitem-qty-' ~ item.id,
                        min: 0,
                        class: [
                          'mt-1 w-20',
                          '[[classes.input]]',
                          errors.has(itemErrorKey ~ '.qty') ? 'outline-[[dangerColor]]-500',
                        ]
                      }) }}
                    </div>
                  {% endif %}

                  <div class="min-w-40 flex-1">
                    <label for="lineitem-note-{{ item.id }}" class="block text-xs font-medium text-gray-600">{{ 'Note'|t }}</label>
                    {{ input('text', 'lineItems[' ~ item.id ~ '][note]', item.note, {
                      id: 'lineitem-note-' ~ item.id,
                      class: 'mt-1 w-full [[classes.input]]',
                      placeholder: 'Add a note'|t
                    }) }}
                  </div>

                  {% if item.options.giftWrapped is defined %}
                    <div>
                      <label for="lineitem-giftWrapped-{{ item.id }}" class="block text-xs font-medium text-gray-600">{{ 'Gift wrap'|t }}</label>
                      {% tag 'select' with {
                        id: 'lineitem-giftWrapped-' ~ item.id,
                        name: 'lineItems[' ~ item.id ~ '][options][giftWrapped]',
                        class: 'mt-1 [[classes.select]]'
                      } %}
                        {{ tag('option', { value: 'no', selected: item.options.giftWrapped == 'no', text: 'No'|t }) }}
                        {{ tag('option', { value: 'yes', selected: item.options.giftWrapped == 'yes', text: 'Yes'|t }) }}
                      {% endtag %}
                    </div>
                  {% endif %}
                </div>

                {% if errors.has(itemErrorKey ~ '.*') %}
                  <p class="text-sm text-[[dangerColor]]-600">{{ errors.get(itemErrorKey ~ '.*')|flatten|join(' ') }}</p>
                {% endif %}

                {% if not cartHasErrors and item.adjustments|length %}
                  <ul class="space-y-1 text-xs text-gray-500">
                    {% for adjustment in item.adjustments %}
                      <li class="flex justify-between gap-4">
                        <span>
                          <span class="font-medium uppercase">{{ adjustment.type }}</span>
                          {{ adjustment.name }}
                          {% if adjustment.isEstimated %}<em>({{ 'estimated'|t }})</em>{% endif %}
                        </span>
                        <span class="tabular-nums">{{ adjustment.amountAsCurrency }}</span>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}

                <label class="inline-flex w-fit cursor-pointer items-center gap-2 text-sm text-gray-500 hover:text-[[dangerColor]]-600">
                  {{ input('checkbox', 'lineItems[' ~ item.id ~ '][remove]', 1, { class: 'size-4 accent-[[dangerColor]]-600' }) }}
                  {{ 'Remove on update'|t }}
                </label>
              </div>
            </li>
          {% endfor %}
        </ul>

        <div class="mt-6 flex items-center justify-between">
          <a href="{{ url('[[folderName]]/products') }}" class="text-sm [[classes.a]]">&larr; {{ 'Continue shopping'|t }}</a>
          <button type="submit" class="[[classes.btn.base]] [[classes.btn.grayColor]]">{{ 'Update cart'|t }}</button>
        </div>
      </section>

      <section class="mt-10 space-y-6 lg:col-span-5 lg:mt-0" aria-labelledby="summary-heading">
        <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-xs">
          <h2 id="summary-heading" class="text-lg font-semibold">{{ 'Order summary'|t }}</h2>

          {% if not cartHasErrors %}
            <div class="mt-6">
              {{ include('[[folderName]]/_private/order/totals', { order: cart }) }}
            </div>

            {% if cart.orderAdjustments|length %}
              <ul class="mt-4 space-y-1 border-t border-gray-200 pt-4 text-xs text-gray-500">
                {% for adjustment in cart.orderAdjustments %}
                  <li class="flex justify-between gap-4">
                    <span>
                      <span class="font-medium uppercase">{{ adjustment.type }}</span>
                      {{ adjustment.name }}
                      {% if adjustment.isEstimated %}<em>({{ 'estimated'|t }})</em>{% endif %}
                    </span>
                    <span class="tabular-nums">{{ adjustment.amountAsCurrency }}</span>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          {% endif %}

          <div class="mt-6 border-t border-gray-200 pt-6">
            <label for="couponCode" class="block text-sm font-medium">{{ 'Coupon code'|t }}</label>
            <div class="mt-2 flex gap-2">
              {{ input('text', 'couponCode', cart.couponCode, {
                id: 'couponCode',
                class: ['w-full', '[[classes.input]]', errors.has('couponCode') ? 'outline-[[dangerColor]]-500'],
              }) }}
              <button type="submit" class="[[classes.btn.base]] [[classes.btn.grayColor]]">{{ 'Apply'|t }}</button>
            </div>
            {% if errors.has('couponCode') %}
              <p class="mt-2 text-sm text-[[dangerColor]]-600">{{ errors.first('couponCode') }}</p>
            {% endif %}
          </div>

          {% if not cartHasErrors %}
            <a href="{{ url('[[folderName]]/checkout') }}" class="mt-6 w-full py-3 text-base [[classes.btn.base]] [[classes.btn.mainColor]]">
              {{- 'Checkout'|t -}}
            </a>
          {% endif %}
        </div>

        {{ include('[[folderName]]/cart/_includes/shipping-estimator') }}
      </section>
    </form>
  {% else %}
    <div class="mt-10 rounded-lg border border-dashed border-gray-300 p-12 text-center">
      <p class="font-semibold">{{ 'Your cart is empty'|t }}</p>
      <p class="mt-1 text-sm text-gray-500">{{ 'Find something you like in the catalog.'|t }}</p>
      <a href="{{ url('[[folderName]]/products') }}" class="mt-6 [[classes.btn.base]] [[classes.btn.mainColor]]">{{ 'Browse products'|t }}</a>
    </div>
  {% endif %}
{% endblock %}
