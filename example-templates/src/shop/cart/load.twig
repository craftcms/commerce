{% extends '[[folderName]]/_private/layouts' %}
{#
Outputs form for collecting a cart number to be loaded.
#}
{% block main %}
  <!-- Template: {{ _self }}.twig -->
  <div class="mx-auto max-w-md rounded-lg border border-gray-200 bg-white p-6 shadow-xs sm:p-8">
    <h1 class="text-xl font-semibold">{{ 'Load a cart'|t }}</h1>
    <p class="mt-1 text-sm text-gray-500">{{ 'Enter a cart number to load that cart into the current session.'|t }}</p>

    <form method="post" action="" class="mt-6 space-y-5">
      {{ csrfInput() }}
      {{ actionInput('commerce/cart/load') }}
      {{ redirectInput('[[folderName]]/cart') }}

      <div>
        <label for="number" class="block text-sm font-medium text-gray-700">{{ 'Cart number'|t }}</label>
        {{ input('text', 'number', null, {
          id: 'number',
          class: 'mt-1 w-full font-mono [[classes.input]]',
          placeholder: '7e89fh0ew8034…'
        }) }}
      </div>

      {{ tag('button', {
        type: 'submit',
        class: 'w-full [[classes.btn.base]] [[classes.btn.mainColor]]',
        text: 'Load cart'|t
      }) }}
    </form>
  </div>
{% endblock %}
