{% extends '[[folderName]]/_private/layouts' %}

{# @var donation \CraftCms\Commerce\Purchasable\Elements\Donation #}
{% set donation = craft.commerce.donation %}

{% block main %}
  <!-- Template: {{ _self }}.twig -->
  <div class="mx-auto max-w-lg rounded-lg border border-gray-200 bg-white p-6 shadow-xs sm:p-8">
    <h1 class="text-2xl font-bold tracking-tight">{{ 'Make a donation'|t }}</h1>

    {% if donation and donation.isAvailable %}
      <p class="mt-1 text-sm text-gray-500">{{ 'Choose an amount, or enter your own.'|t }}</p>

      <form method="post" action="" class="mt-6 space-y-6">
        {{ csrfInput() }}
        {{ actionInput('commerce/cart/update') }}
        {{ successMessageInput('Donation added.'|t) }}
        {{ redirectInput('[[folderName]]/cart') }}
        {{ hiddenInput('purchasableId', donation.id) }}

        <div class="grid grid-cols-3 gap-3">
          {% for amount in [10, 25, 50] %}
            <button type="button" data-amount="{{ amount }}" class="js-donation-amount [[classes.btn.base]] [[classes.btn.grayColor]]">
              {{- amount|currency(cart.currency, stripZeros=true) -}}
            </button>
          {% endfor %}
        </div>

        <div>
          <label for="donation-amount" class="block text-sm font-medium text-gray-700">{{ 'Amount'|t }}</label>
          {{ input('number', 'options[donationAmount]', '', {
            id: 'donation-amount',
            min: 1,
            step: 'any',
            required: true,
            placeholder: '10',
            class: 'mt-1 w-full [[classes.input]]'
          }) }}
        </div>

        {{ tag('button', {
          type: 'submit',
          class: 'w-full [[classes.btn.base]] [[classes.btn.mainColor]]',
          text: 'Add donation to cart'|t
        }) }}
      </form>

      {% js %}
        document.querySelectorAll('.js-donation-amount').forEach(function(button) {
          button.addEventListener('click', function() {
            document.querySelector('#donation-amount').value = button.dataset.amount;
          });
        });
      {% endjs %}
    {% else %}
      <p class="mt-2 text-sm text-gray-500">{{ 'Donations aren’t available right now.'|t }}</p>
    {% endif %}
  </div>
{% endblock %}
