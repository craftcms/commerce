{% extends '[[folderName]]/_private/layouts' %}

{% if currentUser %}
  {% redirect '[[folderName]]/checkout/addresses' %}
{% endif %}

{% if cart is not defined %}
  {% set cart = craft.commerce.carts.cart %}
{% endif %}

{% if not cart.email %}
  {% redirect '[[folderName]]/checkout' %}
{% endif %}

{% set userExistsButCantLogin = craft.users
  .email(cart.email ?? 'NULL')
  .status(['locked','suspended','pending'])
  .one() %}

{% if userExistsButCantLogin %}
  {% redirect '[[folderName]]/checkout/addresses' %}
{% endif %}

{% set userExists = craft.users.email(cart.email ?? 'NULL').one() %}

{% block main %}
  <!-- Template: {{ _self }}.twig -->
  <div class="mx-auto max-w-4xl">
    <h1 class="text-xl font-semibold">{{ 'How would you like to check out?'|t }}</h1>

    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <div class="[[classes.box.base]]">
        {% if userExists and userExists.getIsCredentialed() %}
          <h2 class="text-lg font-semibold">{{ 'Sign in'|t }}</h2>
          <p class="mt-1 text-sm text-gray-500">{{ 'You already have an account with us.'|t }}</p>
          {% include '[[folderName]]/customer/_includes/sign-in' with {
            redirectUrl : '[[folderName]]/checkout/addresses'
          } %}
        {% elseif ProjectConfig.get('users.allowPublicRegistration') %}
          <h2 class="text-lg font-semibold">{{ 'Create an account'|t }}</h2>
          <p class="mt-1 text-sm text-gray-500">{{ 'Save your details for faster checkout next time.'|t }}</p>
          {% include '[[folderName]]/customer/_includes/register' with {
            redirectUrl : '[[folderName]]/checkout/addresses'
          } %}
        {% else %}
          <h2 class="text-lg font-semibold">{{ 'Create an account'|t }}</h2>
          <p class="mt-1 text-sm text-gray-500">{{ 'Registration isn’t available on this site.'|t }}</p>
        {% endif %}
      </div>

      <div class="flex flex-col justify-between rounded-lg border border-gray-200 bg-gray-50 p-6">
        <div>
          <h2 class="text-lg font-semibold">{{ 'Guest checkout'|t }}</h2>
          <p class="mt-1 text-sm text-gray-500">{{ 'No account needed. You can create one after placing your order.'|t }}</p>
        </div>
        <a href="{{ url('[[folderName]]/checkout/addresses') }}" class="mt-6 w-full [[classes.btn.base]] [[classes.btn.grayColor]]">
          {{- 'Continue as guest'|t -}}
        </a>
      </div>
    </div>
  </div>
{% endblock %}
