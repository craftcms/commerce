{% extends '[[folderName]]/_private/layouts' %}

{% set paymentSources = craft.commerce.paymentSources.getAllPaymentSourcesByCustomerId(currentUser.id ?? null) %}

{% block main %}
{% set availableGateways = cart.availableGateways %}

  <!-- Template: {{ _self }}.twig -->
  <div class="lg:grid lg:grid-cols-12 lg:items-start lg:gap-x-12">
    <div class="space-y-8 rounded-lg border border-gray-200 bg-white p-6 shadow-xs sm:p-8 lg:col-span-7">
      <h1 class="text-xl font-semibold">
        {{- 'How would you like to pay?'|t -}}
      </h1>

      {% if availableGateways is empty %}
        <p>{{ 'No payment methods available.'|t }}</p>
      {% endif %}

      {% if availableGateways|length %}
        <div>
          <form method="post" action="" class="space-y-8">
            {{ csrfInput() }}
            {{ actionInput('commerce/cart/update') }}
            {{ redirectInput(siteUrl('[[folderName]]/checkout/options')) }}
            {{ successMessageInput('Payment options selected.') }}

            <div>
              {{ include('[[folderName]]/checkout/_includes/gateways', {
                availableGateways: availableGateways,
                paymentSources: paymentSources
              }) }}
            </div>

            {{ include('[[folderName]]/checkout/_includes/currencies') }}

            <div class="mt-6 flex justify-end">
              {{ tag('button', {
                type: 'submit',
                name: 'submit',
                class: '[[classes.btn.base]] [[classes.btn.mainColor]]',
                text: 'Continue'|t
              }) }}
            </div>
          </form>
        </div>
      {% endif %}
    </div>
    <div class="mt-10 lg:col-span-5 lg:mt-0">
      {{ include('[[folderName]]/checkout/_includes/order-summary', {
        showShippingAddress: true,
        showShippingMethod: true
      }) }}
    </div>
  </div>
{% endblock %}
