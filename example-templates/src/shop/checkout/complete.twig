{% extends '[[folderName]]/_private/layouts' %}

{% block main %}
  {% if not cart.gateway %}
    {% redirect '[[folderName]]/checkout/payment-method' %}
  {% endif %}

  <div class="mx-auto max-w-md">
    <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-xs sm:p-8">
      <h1 class="text-xl font-semibold">
        {{- 'Commit to buy'|t -}}
      </h1>
      <p class="mt-1 text-sm text-gray-500">{{ 'Place your order now and pay for it later.'|t }}</p>
      <div class="mt-6">
        <form id="completeForm"
              method="post"
              action=""
        >
          {{ csrfInput() }}
          {{ actionInput('commerce/cart/complete') }}
          {{ redirectInput(siteUrl('/[[folderName]]/customer/order', {
            number: cart.number,
            success: 'true'
          })) }}
          {{ tag('button', {
            type: 'submit',
            class: 'w-full [[classes.btn.base]] [[classes.btn.mainColor]]',
            text: 'Place order'|t
          }) }}
        </form>
      </div>
    </div>
  </div>
{% endblock %}
