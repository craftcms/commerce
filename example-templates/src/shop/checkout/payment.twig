{% extends '[[folderName]]/_private/layouts' %}

{# @var cart \CraftCms\Commerce\Order\Elements\Order #}

{% block main %}

  {% if not cart.gateway %}
    {% redirect '[[folderName]]/checkout/payment-method' %}
  {% endif %}

  <div class="lg:grid lg:grid-cols-12 lg:items-start lg:gap-x-12">
    <div class="space-y-8 rounded-lg border border-gray-200 bg-white p-6 shadow-xs sm:p-8 lg:col-span-7">
      <h1 class="text-xl font-semibold">{{ 'Payment'|t }}</h1>

      {% if cart.gatewayId or cart.paymentSourceId %}
        {# A failed payment redirects back with the payment form's errors in the `errors` bag #}
        {% if session().get('modelName') == 'paymentForm' and errors.any() %}
          <div class="rounded-lg border border-[[dangerColor]]-200 bg-[[dangerColor]]-50 px-4 py-3 text-sm text-[[dangerColor]]-800" role="alert">
            <p class="font-semibold">{{ 'Please check your payment details.'|t }}</p>
            <ul class="mt-1 list-disc space-y-1 pl-5">
              {% for key, messages in errors.getMessages() %}
                {% for message in messages %}
                  <li>{{ message }}</li>
                {% endfor %}
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        <div class="mt-3">
          <form id="paymentForm" method="post" action="">
            {{ csrfInput() }}
            {{ actionInput('commerce/payments/pay') }}
            {{ redirectInput(siteUrl('/[[folderName]]/customer/order', {
              number: cart.number,
              success: 'true'
            })) }}
            {{ hiddenInput('cancelUrl', siteUrl('/[[folderName]]/checkout/payment')|hash) }}
            {{ hiddenInput('orderEmail', cart.email) }}

            {{ include('[[folderName]]/checkout/_includes/partial-payment') }}

            {% if cart.gatewayId %}
              {{ hiddenInput('gatewayId', cart.gatewayId) }}
              {% set params = {} %}

              {# Special params for Paypal checkout #}
              {% if className(cart.gateway) == 'craft\\commerce\\paypalcheckout\\gateways\\Gateway' %}
                {% set params = { currency: cart.paymentCurrency } %}
              {% endif %}

              {% if className(cart.gateway) == 'craft\\commerce\\stripe\\gateways\\PaymentIntents' %}
                {% set params = {
                  appearance: {
                    theme: 'stripe'
                  },
                  elementOptions: {
                    layout: {
                      type: 'accordion',
                      defaultCollapsed: false,
                      radios: false,
                      spacedAccordionItems: false
                    }
                  },
                  order: cart,
                  submitButtonClasses: 'w-full [[classes.btn.base]] [[classes.btn.mainColor]]',
                  submitButtonText: 'Pay',
                  errorMessageClasses: 'rounded-md bg-[[dangerColor]]-50 p-3 text-sm text-[[dangerColor]]-700',
                } %}
              {% endif %}
              <div class="gateway-payment-form mt-6 [[classes.gatewayForm]]">
                {% namespace cart.gateway.handle|commercePaymentFormNamespace %}
                    {{ cart.gateway.getPaymentFormHtml(params)|raw }}
                {% endnamespace %}

                {% if cart.gateway.supportsPaymentSources() and currentUser %}
                  <label class="flex items-center gap-2 text-sm text-gray-700">
                    {{ input('checkbox', 'savePaymentSource', 1, { class: 'size-4' }) }}
                    {{ 'Save card for future purchases'|t }}
                  </label>
                {% endif %}
              </div>
            {% else %}
              {{ cart.gateway.getPaymentConfirmationFormHtml({})|raw }}
            {% endif %}

            {% if cart.paymentSourceId or cart.gateway.showPaymentFormSubmitButton() %}
              {{ tag('button', {
                type: 'submit',
                class: 'mt-6 w-full py-3 text-base [[classes.btn.base]] [[classes.btn.mainColor]]',
                text: 'Pay now'|t
              }) }}
              <p class="text-center text-xs text-gray-500">{{ 'Your payment details are sent securely to the payment gateway.'|t }}</p>
            {% endif %}
          </form>
        </div>
      {% endif %}
      {% if cart.store.allowCheckoutWithoutPayment %}
        <div class="border-t border-gray-200 pt-8">
          <h2 class="text-base font-semibold">{{ 'Pay later'|t }}</h2>
          <p class="mt-1 text-sm text-gray-500">{{ 'Place your order now and pay for it later.'|t }}</p>
          <form id="completeForm" method="post" action="" class="mt-4">
            {{ csrfInput() }}
            {{ actionInput('commerce/cart/complete') }}
            {{ redirectInput(siteUrl('/[[folderName]]/customer/order', {
              number: cart.number,
              success: 'true'
            })) }}
            {{ successMessageInput('Thank you for your order. We’ve received it and are awaiting payment.'|t) }}
            {{ tag('button', {
              type: 'submit',
              class: '[[classes.btn.base]] [[classes.btn.grayColor]]',
              text: 'Place order without paying'|t
            }) }}
          </form>
        </div>
      {% endif %}
    </div>

    <div class="mt-10 lg:col-span-5 lg:mt-0">
      {{ include('[[folderName]]/checkout/_includes/order-summary', {
        showShippingAddress: true,
        showShippingMethod: true
      }) }}
    </div>
  </div>

  {% js %}
    var $paymentForm = document.querySelector('#paymentForm');
    if ($paymentForm) {
      // Only allow the payment form submit to be triggered once.
      $paymentForm.addEventListener('submit', function(ev) {
        if ($paymentForm.dataset.processing) {
          ev.preventDefault();
          return false;
        }

        $paymentForm.dataset.processing = true;
      });
    }
  {% endjs %}

{% endblock %}
