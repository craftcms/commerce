{% extends '_layouts/basecp.twig' %}
{% import '_includes/forms.twig' as forms %}
{% set title = "Sign In"|t('app') %}
{% set bodyClass = 'login' %}

{% set hasLogo = CraftEdition >= CraftPro and craft.rebrand.isLogoUploaded %}

{% if hasLogo %}
    {% set logo = craft.rebrand.logo %}
{% endif %}

{% block body %}
    <main>
        {% if hasLogo %}
        <h1>
            {{ tag('img', {
                id: 'login-logo',
                src: logo.url,
                alt: systemName,
                width: logo.width,
                height: logo.height,
            }) }}
        </h1>
        {% endif %}

        {% if craft.app.session.hasFlash('error') %}
            <div class="error">
                {{ craft.app.session.getFlash('error') }}
            </div>
        {% endif %}

        <div class="pane secondary">
            {% tag 'form' with {
                'action': url(''),
                method: 'post',
                'accept-charset': 'UTF-8',
            } %}
            <p>Please confirm the email associated with this order.</p>

            {{ csrfInput() }}
            {{ actionInput('commerce/downloads/pdf-challenge') }}
            {{ hiddenInput('orderNumber', order.number) }}
            {{ hiddenInput('pdfHandle', pdfHandle) }}
            {{ hiddenInput('option', option) }}
            {{ hiddenInput('inline', inline) }}

            {{ forms.textField({
                label: 'Email Address'|t('app'),
                name: 'email',
                value: '',
                autocomplete: 'email',
                placeholder: order.maskedEmail,
                type: 'email',
                errors: errors.email ?? null,
                autofocus: true,
                inputAttributes: {
                    aria: {
                        required: 'true',
                    },
                },
            }) }}

            {{ forms.submitButton({
                class: ['fullwidth', 'last'],
                label: 'Submit'|t('app'),
                spinner: true,
            }) }}
            {% endtag %}

        </div>
    </div>
    </main>
{% endblock %}

{% css %}
html {
    height: 100%;
}
{% endcss %}