{# @var rows \Illuminate\Support\Collection #}
{# @var inventoryLocation \craft\commerce\models\InventoryLocation #}

<div style="width: min(56rem, calc(100vw - 6rem));">
    <h2>{{ title }}</h2>

    <div class="flex flex-wrap" style="gap: var(--l); margin-block: var(--s) var(--m);">
        <div><span class="light">{{ 'Location'|t('app') }}:</span> <strong>{{ inventoryLocation.getUiLabel() }}</strong></div>
        <div><span class="light">{{ 'Reserved'|t('commerce') }}:</span> <strong>{{ reservedTotal }}</strong></div>
    </div>

    {% if rows|length %}
        <div style="max-height: min(28rem, calc(100vh - 16rem)); overflow: auto;">
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th scope="col">{{ 'Order'|t('commerce') }}</th>
                        <th scope="col">{{ 'Date Ordered'|t('commerce') }}</th>
                        <th scope="col">{{ 'Order Status'|t('commerce') }}</th>
                        <th scope="col">{{ 'Item'|t('commerce') }}</th>
                        <th scope="col" class="thin">{{ 'Qty'|t('commerce') }}</th>
                        <th scope="col" class="thin">{{ 'Reserved'|t('commerce') }}</th>
                        <th scope="col">{{ 'Committed'|t('commerce') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            <th scope="row">
                                {{ tag('a', {
                                    text: row.order.reference ?: row.order.shortNumber,
                                    href: row.order.getCpEditUrl(),
                                    target: '_blank',
                                    rel: 'noopener',
                                    class: 'go',
                                    title: 'Open in a new tab'|t('app'),
                                }) }}
                                {% if row.order.email %}
                                    <div class="smalltext light">{{ row.order.email }}</div>
                                {% endif %}
                            </th>
                            <td>{{ row.order.dateOrdered ? row.order.dateOrdered|datetime('short') }}</td>
                            <td>{{ row.order.getOrderStatus() ? row.order.getOrderStatus().getLabelHtml()|raw }}</td>
                            <td>
                                {{ row.lineItem.description }}
                                <div class="smalltext light code">{{ row.lineItem.sku }}</div>
                            </td>
                            <td class="thin">{{ row.lineItem.qty }}</td>
                            <td class="thin"><strong>{{ row.reservedQuantity }}</strong></td>
                            <td>
                                {% for committedLevel in row.committedLevels %}
                                    <div>{{ committedLevel.getInventoryLocation().getUiLabel() }}: <strong>{{ committedLevel.outstandingCommittedQuantity }}</strong></div>
                                {% else %}
                                    <span class="light">0</span>
                                {% endfor %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="zilch small">{{ 'No results.'|t('app') }}</p>
    {% endif %}
</div>
