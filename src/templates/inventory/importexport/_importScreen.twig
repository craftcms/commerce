{% import '_includes/forms' as forms %}

{{ forms.fileField({
    label: 'Attach import file'|t('commerce'),
    name: 'importFile',
    inputAttributes: {
        accept: '.csv'
    }
}) }}

{% if errors is defined %}
{% for line, lineErrors in errors %}
    <div>Errors Line {{ line }}:</div>
    {% for error in lineErrors %}
        <li>{{ error }}</li>
    {% endfor %}
{% endfor %}
{% endif %}


