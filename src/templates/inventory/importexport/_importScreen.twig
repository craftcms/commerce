{% import '_includes/forms' as forms %}

{{ forms.fileField({
    label: 'Attach import file'|t('commerce'),
    name: 'importFile',
    inputAttributes: {
        accept: '.csv'
    }
}) }}

{{  forms.textField({
    name: 'another',
    value: 'aaa',
}) }}

{% if errors is defined %}
{% for line, lineErrors in errors %}
    <h6>{{ "Errors on Line {line}:"|t('commerce', {line: line}) }}</h6>
    {{ forms.errorList(lineErrors) }}
{% endfor %}
{% endif %}


