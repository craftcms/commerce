{% import '_includes/forms.twig' as forms %}

{% for inventoryLocationId, fulfillmentLevels in inventoryFulfillmentLevels %}
    <h3>{{ fulfillmentLevels[0].getInventoryLocation().name }}</h3>
    <table class="data fullwidth">
        <tr>
            <th>{{ "Description"|t('commerce') }}</th>
            <th>{{ "Fulfilled"|t('commerce') }}</th>
            <th>{{ "Fulfill"|t('commerce') }}</th>
        </tr>
        {% for fulfillmentLevel in fulfillmentLevels %}
            {% set fieldIndex = random() %}
            <tr>
            <td class="">{{fulfillmentLevel.getLineItem().description}}</td>
            <td class="">{{fulfillmentLevel.fulfilledQuantity}} / {{fulfillmentLevel.committedQuantity}}</td>
            <td class="">
                <div id="fulfillment-{{ fieldIndex }}">
                {{ forms.text({
                    type: 'number',
                    inputAttributes: {
                        max: fulfillmentLevel.getMaxFulfillQuantity(),
                        min: -fulfillmentLevel.fulfilledQuantity,
                        step: 1,
                        class: 'fulfillment-quantity',
                    },
                    name: 'fulfillment['~fieldIndex~'][quantity]',
                }) }}
                {% if fulfillmentLevel.isShortOfStock %}
                    <p class="warning has-icon">
                        <span class="icon" aria-hidden="true"></span>
                        <span class="visually-hidden">{{ 'Warning'|t('app') }}: </span>
                        <span>{{ 'Only {quantity} in stock at this location. Transfer more stock here to fulfill the rest.'|t('commerce', { quantity: fulfillmentLevel.getFulfillableQuantity() }) }}</span>
                    </p>
                {% endif %}
                </div>
                {{ hiddenInput('fulfillment['~fieldIndex~'][max]', fulfillmentLevel.getMaxFulfillQuantity()) }}
                {{ hiddenInput('fulfillment['~fieldIndex~'][inventoryLocationId]', fulfillmentLevel.inventoryLocationId) }}
                {{ hiddenInput('fulfillment['~fieldIndex~'][inventoryItemId]', fulfillmentLevel.inventoryItemId) }}
                {{ hiddenInput('fulfillment['~fieldIndex~'][lineItemId]', fulfillmentLevel.lineItemId) }}
            </td>
            </tr>
        {% endfor %}
    </table>
{% endfor %}