{% do view.registerAssetBundle('craft\\web\\assets\\admintable\\AdminTableAsset') -%}
{% do view.registerTranslations('commerce', [
    'Amount',
    'Current Rate',
    'Currency',
    'Date',
    'Gateway',
    'info',
    'N/A',
    'No transactions exist.',
    'Payment Amount',
    'Show snapshotted payment currency rates',
    'Snapshotted Rate',
    'Status',
    'These exchange rates were captured when the order was completed and are used for subsequent partial payments.',
    'These exchange rates were captured when the order was completed and are used for subsequent partial payments. This behavior is controlled by the {link}Lock Payment Currency Rate on Order Completion{endlink} store setting.',
    'Type',
]) %}

<div id="transactionsTab" class="hidden">

    <div id="transactions-vue-admin-table"></div>

    {% if not order.isPaid() %}
        <div class="footer">
            <a class="btn" id="make-payment" data-order-id="{{ order.id }}">{{ 'Make a payment'|t('commerce') }}</a>
        </div>
    {% endif %}

    {% if order.isCompleted and order.paymentCurrencyRates is not empty and order.store.getUsesSnapshotPaymentCurrencyRate() %}
        <hr>
        <p>
            <a class="fieldtoggle" data-target="snapshotted-payment-currency-rates">{{ 'Show snapshotted payment currency rates'|t('commerce') }}</a>
        </p>
        <div id="snapshotted-payment-currency-rates" class="hidden">
            {% if currentUser.admin %}
                <p class="light">{{ 'These exchange rates were captured when the order was completed and are used for subsequent partial payments. This behavior is controlled by the {link}Lock Payment Currency Rate on Order Completion{endlink} store setting.'|t('commerce', {
                    link: '<a href="' ~ url('commerce/settings/stores/' ~ order.store.id) ~ '">',
                    endlink: '</a>'
                })|raw }}</p>
            {% else %}
                <p class="light">{{ 'These exchange rates were captured when the order was completed and are used for subsequent partial payments.'|t('commerce') }}</p>
            {% endif %}
            {% set currentPaymentCurrencies = craft.commerce.paymentCurrencies.getAllPaymentCurrencies(order.store.id) %}
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ 'Currency'|t('commerce') }}</th>
                        <th>{{ 'Snapshotted Rate'|t('commerce') }}</th>
                        <th>{{ 'Current Rate'|t('commerce') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for iso, rate in order.paymentCurrencyRates %}
                        {% set currentCurrency = currentPaymentCurrencies|filter(c => c.iso == iso)|first %}
                        {% set currentRate = currentCurrency ? currentCurrency.rate : null %}
                        <tr>
                            <td>{{ iso }}</td>
                            <td>{{ rate }}</td>
                            <td>
                                {% if currentRate is not null %}
                                    {{ currentRate }}
                                    {% if currentRate != rate %}
                                        <span class="light">({{ currentRate > rate ? '+' : '' }}{{ ((currentRate - rate) / rate * 100)|number_format(2) }}%)</span>
                                    {% endif %}
                                {% else %}
                                    <span class="light">{{ 'N/A'|t('commerce') }}</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>


{% js %}
var columns = [
    { name: 'type', title: Craft.t('commerce', 'Type'),
        callback: function(value) {
            return '<span style="padding-left: '+value.level+'em;">'+
                ((value.level) ? '<span class="extralight">&#8627;</span> ' : '') +
                Craft.escapeHtml(value.label)+'</span>';
        }
    },
    { name: 'status', title: Craft.t('commerce', 'Status'),
        callback: function(value) {
            return '<span class="transaction-status transaction-status-'+Craft.escapeHtml(value.key)+'">'+Craft.escapeHtml(value.label)+'</span>';
        }
    },
    { name: 'amount', title: Craft.t('commerce', 'Amount'),
        callback: function(value) {
            return value;
        }
    },
    { name: 'paymentAmount', title: Craft.t('commerce', 'Payment Amount') },
    { name: 'gateway', title: Craft.t('commerce', 'Gateway') },
    { name: 'date', title: Craft.t('commerce', 'Date') },
    { name: 'info', title: Craft.t('commerce', 'Info'),
        callback: function(value) {
            return '<span class="infoRow" data-info=\''+JSON.stringify(value)+'\'>' +
                '<span class="tableRowInfo" data-icon="info"></span></span>';
        }
    },
    { name: 'actions', title: '',
        callback: function(value) {
            return value;
        }
    }
];

new Craft.VueAdminTable({
    columns: columns,
    container: '#transactions-vue-admin-table',
    emptyMessage: Craft.t('commerce', 'No transactions exist.'),
    padded: true,
    tableData: {{ orderTransactions|json_encode|raw }},
    onLoaded: function() {
      {% if not (order.paidStatus == constant('craft\\commerce\\elements\\Order::PAID_STATUS_UNPAID')) %}
        $(document).ready(function() {
          new Craft.Money(
            'refund-amount',
            {
              decimals: window.orderEdit.currencyConfig.decimals,
              placeholder: '0',
              decimalSeparator: window.orderEdit.currencyConfig.decimalSeparator,
              groupSeparator: window.orderEdit.currencyConfig.groupSeparator,
            }
          );
        });
      {% endif %}
    },
});
{% endjs %}
