APP_NAME="Craft Commerce Workbench"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8125

DB_CONNECTION=sqlite
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

WORKBENCH_ADMIN_EMAIL=admin@example.test
WORKBENCH_ADMIN_USERNAME=admin
WORKBENCH_ADMIN_PASSWORD=craftcms2018!!

CRAFT_EDITION=pro

# The CMS feature branch needs assets built from the same source checkout.
# WORKBENCH_CMS_ASSETS_PATH=/absolute/path/to/cms/cms-assets/resources
