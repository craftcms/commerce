{
  "name": "craftcms/commerce",
  "description": "Craft Commerce",
  "type": "craft-plugin",
  "keywords": [
    "cms",
    "craftcms",
    "commerce",
    "yii2"
  ],
  "homepage": "https://craftcms.com/commerce",
  "license": "proprietary",
  "support": {
    "email": "support@craftcms.com",
    "issues": "https://github.com/craftcms/commerce/issues?state=open",
    "forum": "https://craftcms.stackexchange.com/",
    "source": "https://github.com/craftcms/commerce",
    "docs": "https://craftcms.com/docs/commerce/4.x/",
    "rss": "https://github.com/craftcms/commerce/releases.atom"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.5",
    "craftcms/cms": "dev-feature/6.x-form-component-compatibility-and-usage-updates",
    "dompdf/dompdf": "^3.1.6",
    "ibericode/vat": "^2.0",
    "iio/libmergepdf": "^4.0",
    "moneyphp/money": "^4.2.0"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/yii2-adapter": "6.x-dev",
    "dg/bypass-finals": "^1.9",
    "fakerphp/faker": "^1.19.0",
    "larastan/larastan": "^3.4",
    "league/factory-muffin": "^3.3.0",
    "orchestra/testbench": "^11.0",
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-arch": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "phpstan/phpstan": "^2.1",
    "rector/rector": "^2.0",
    "vlucas/phpdotenv": "^5.4.1"
  },
  "autoload": {
    "psr-4": {
      "craft\\commerce\\": "src-yii2/",
      "CraftCms\\Commerce\\": "src/",
      "craftcommercetests\\fixtures\\": "tests-yii2/fixtures/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CraftCms\\Commerce\\Tests\\": "tests/"
    }
  },
  "extra": {
    "handle": "commerce",
    "name": "Craft Commerce",
    "description": "Create beautifully bespoke ecommerce experiences",
    "developer": "Pixel & Tonic",
    "documentationUrl": "https://craftcms.com/docs/commerce/4.x/",
    "laravel": {
      "aliases": {
        "AdjusterTypes": "CraftCms\\Commerce\\Support\\Facades\\AdjusterTypes",
        "Carts": "CraftCms\\Commerce\\Support\\Facades\\Carts",
        "CatalogPricing": "CraftCms\\Commerce\\Support\\Facades\\CatalogPricing",
        "CatalogPricingRules": "CraftCms\\Commerce\\Support\\Facades\\CatalogPricingRules",
        "Coupons": "CraftCms\\Commerce\\Support\\Facades\\Coupons",
        "Currencies": "CraftCms\\Commerce\\Support\\Facades\\Currencies",
        "Customers": "CraftCms\\Commerce\\Support\\Facades\\Customers",
        "DiscountAdjusterTypes": "CraftCms\\Commerce\\Support\\Facades\\DiscountAdjusterTypes",
        "Discounts": "CraftCms\\Commerce\\Support\\Facades\\Discounts",
        "Emails": "CraftCms\\Commerce\\Support\\Facades\\Emails",
        "Formulas": "CraftCms\\Commerce\\Support\\Facades\\Formulas",
        "GatewayTypes": "CraftCms\\Commerce\\Support\\Facades\\GatewayTypes",
        "Gateways": "CraftCms\\Commerce\\Support\\Facades\\Gateways",
        "Inventory": "CraftCms\\Commerce\\Support\\Facades\\Inventory",
        "InventoryLocations": "CraftCms\\Commerce\\Support\\Facades\\InventoryLocations",
        "LineItemStatuses": "CraftCms\\Commerce\\Support\\Facades\\LineItemStatuses",
        "LineItems": "CraftCms\\Commerce\\Support\\Facades\\LineItems",
        "OrderAdjustments": "CraftCms\\Commerce\\Support\\Facades\\OrderAdjustments",
        "OrderHistories": "CraftCms\\Commerce\\Support\\Facades\\OrderHistories",
        "OrderNotices": "CraftCms\\Commerce\\Support\\Facades\\OrderNotices",
        "OrderStatuses": "CraftCms\\Commerce\\Support\\Facades\\OrderStatuses",
        "Orders": "CraftCms\\Commerce\\Support\\Facades\\Orders",
        "PaymentCurrencies": "CraftCms\\Commerce\\Support\\Facades\\PaymentCurrencies",
        "PaymentSources": "CraftCms\\Commerce\\Support\\Facades\\PaymentSources",
        "Payments": "CraftCms\\Commerce\\Support\\Facades\\Payments",
        "Pdfs": "CraftCms\\Commerce\\Support\\Facades\\Pdfs",
        "ProductTypes": "CraftCms\\Commerce\\Support\\Facades\\ProductTypes",
        "Products": "CraftCms\\Commerce\\Support\\Facades\\Products",
        "PurchasableTypes": "CraftCms\\Commerce\\Support\\Facades\\PurchasableTypes",
        "Purchasables": "CraftCms\\Commerce\\Support\\Facades\\Purchasables",
        "Sales": "CraftCms\\Commerce\\Support\\Facades\\Sales",
        "ShippingCategories": "CraftCms\\Commerce\\Support\\Facades\\ShippingCategories",
        "ShippingMethods": "CraftCms\\Commerce\\Support\\Facades\\ShippingMethods",
        "ShippingRuleCategories": "CraftCms\\Commerce\\Support\\Facades\\ShippingRuleCategories",
        "ShippingRules": "CraftCms\\Commerce\\Support\\Facades\\ShippingRules",
        "ShippingZones": "CraftCms\\Commerce\\Support\\Facades\\ShippingZones",
        "StoreSettings": "CraftCms\\Commerce\\Support\\Facades\\StoreSettings",
        "Stores": "CraftCms\\Commerce\\Support\\Facades\\Stores",
        "TaxCategories": "CraftCms\\Commerce\\Support\\Facades\\TaxCategories",
        "TaxRates": "CraftCms\\Commerce\\Support\\Facades\\TaxRates",
        "TaxZones": "CraftCms\\Commerce\\Support\\Facades\\TaxZones",
        "Taxes": "CraftCms\\Commerce\\Support\\Facades\\Taxes",
        "Transactions": "CraftCms\\Commerce\\Support\\Facades\\Transactions",
        "Transfers": "CraftCms\\Commerce\\Support\\Facades\\Transfers",
        "Variants": "CraftCms\\Commerce\\Support\\Facades\\Variants",
        "Vat": "CraftCms\\Commerce\\Support\\Facades\\Vat",
        "Webhooks": "CraftCms\\Commerce\\Support\\Facades\\Webhooks"
      }
    }
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "tests": [
      "Composer\\Config::disableProcessTimeout",
      "./vendor/bin/pest --compact"
    ],
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
    "prepare": "@php vendor/bin/testbench package:discover --ansi"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true,
      "pestphp/pest-plugin": true
    }
  }
}
